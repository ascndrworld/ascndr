# ─────────────────────────────────────────────────────────────
# Variables de tracking — copia este archivo a ".env" y rellena
# los valores. Deja vacía cualquier herramienta que no uses.
#
#   cp .env.example .env
#
# El prefijo PUBLIC_ es obligatorio (Astro las expone al cliente).
# ─────────────────────────────────────────────────────────────

# Google Tag Manager — ID del contenedor (formato GTM-XXXXXXX)
PUBLIC_GTM_ID=

# Google Analytics 4 — ID de medición (formato G-XXXXXXXXXX)
# Si configuras GA4 DENTRO de GTM, deja esto vacío para no duplicar datos.
PUBLIC_GA4_ID=

# Meta Pixel — ID numérico del píxel de Facebook/Instagram
# Si configuras el píxel DENTRO de GTM, deja esto vacío.
PUBLIC_META_PIXEL_ID=

# Google Search Console — token de la etiqueta de verificación HTML
PUBLIC_GSC_VERIFICATION=
