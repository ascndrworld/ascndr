---
import Header from "../components/Header.astro";
import Analytics from "../components/Analytics.astro";
import CookieConsent from "../components/CookieConsent.astro";
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
}
const {
  title = "Ascndr · Consultoría Creativa - Branding, Lanzamientos y RRSS",
  description = "Ascndr es una consultoría creativa especializada en estrategia en redes sociales, branding, identidad visual, dirección creativa de eventos y dirección de proyectos multimedia.",
  canonical = "https://www.ascndrworld.com",
  ogImage = "https://www.ascndrworld.com/images/og-ascndr.jpg",
  ogImageAlt = "Ascndr — Consultoría creativa: branding, dirección creativa y redes sociales",
  ogType = "website"
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>

  <!-- ── Analytics & tracking ── -->
  <Analytics />

  <!-- ── SEO básico ── -->
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="robots" content="index, follow"/>
  <meta name="author" content="Ascndr"/>
  <meta name="theme-color" content="#0a0a0a"/>
  <link rel="canonical" href={canonical}/>

  <!-- ── Favicons ── -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
  <link rel="shortcut icon" href="/favicon.ico"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>

  <!-- ── PWA / modo app (pantalla completa, contenido tras la isla) ── -->
  <link rel="manifest" href="/site.webmanifest"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <meta name="apple-mobile-web-app-title" content="Ascndr"/>

  <!-- ── Open Graph ── -->
  <meta property="og:type" content={ogType}/>
  <meta property="og:site_name" content="Ascndr"/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:image:alt" content={ogImageAlt}/>
  <meta property="og:locale" content="es_ES"/>

  <!-- ── Twitter Card ── -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>
  <meta name="twitter:image:alt" content={ogImageAlt}/>

  <!-- ── Schema.org LocalBusiness ── -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Ascndr",
    "description": "Estudio creativo especializado en branding, identidad visual, dirección creativa de eventos, fotografía y gestión de redes sociales. Desde Jaén, para marcas de toda España.",
    "url": "https://www.ascndrworld.com",
    "logo": "https://www.ascndrworld.com/ascndr-logo.png",
    "image": ogImage,
    "email": "frank@ascndrworld.com",
    "telephone": "+34667241262",
    "priceRange": "€€",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Jaén",
      "addressRegion": "Andalucía",
      "addressCountry": "ES"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 37.7796,
      "longitude": -3.7849
    },
    "areaServed": ["Jaén", "Andalucía", "España"],
    "serviceType": ["Branding", "Identidad Visual", "Dirección Creativa", "Fotografía de Eventos", "Gestión de Redes Sociales", "Marketing Digital"],
    "sameAs": ["https://www.instagram.com/ascndr.world"]
  })} />

  <!-- ── Fuentes ── -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>

  <slot name="head"/>
</head>
<body>
  {GTM_ID && (
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  )}
  <Header />
  <slot />
  <CookieConsent />

  <!-- Revela el caption de las tarjetas al DESLIZAR el dedo por encima (táctil),
       sin abrir el proyecto; un toque limpio sí navega. En escritorio manda :hover. -->
  <script is:inline>
    (function(){
      var SEL = '.tp-item, .hs-work-item';
      var active = null, moved = false;
      function setActive(el){
        if (active === el) return;
        if (active) active.classList.remove('is-touch-active');
        active = el;
        if (el) el.classList.add('is-touch-active');
      }
      document.addEventListener('touchstart', function(){ moved = false; }, { passive: true });
      document.addEventListener('touchmove', function(e){
        moved = true;
        var t = e.touches[0];
        if (!t) return;
        var el = document.elementFromPoint(t.clientX, t.clientY);
        setActive(el && el.closest ? el.closest(SEL) : null);
      }, { passive: true });
      document.addEventListener('touchend', function(){ setActive(null); }, { passive: true });
      document.addEventListener('touchcancel', function(){ setActive(null); }, { passive: true });
      // Si venías deslizando, cancela la apertura accidental de la tarjeta.
      document.addEventListener('click', function(e){
        if (!moved) return;
        var item = e.target && e.target.closest ? e.target.closest(SEL) : null;
        if (item) { e.preventDefault(); e.stopPropagation(); }
      }, true);
    })();
  </script>
</body>
</html>
<style is:global>
  @import "../styles/global.css";
</style>
