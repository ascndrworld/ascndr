---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

// Autor real detrás de los artículos — señal E-E-A-T (persona, no solo marca).
// Ajusta nombre/cargo/bio a tu gusto; alimenta el schema y la firma visible.
const AUTHOR = {
  name: "Frank Martos",
  initials: "FM",
  jobTitle: "Fundador y director creativo de Ascndr",
  bio: "Fundador de Ascndr. Dirige los proyectos de branding, dirección creativa y redes sociales del estudio, del concepto a la ejecución.",
  url: "https://www.ascndrworld.com",
  sameAs: ["https://www.instagram.com/ascndr.world"],
};

const url = `https://www.ascndrworld.com/blog/${post.id}`;
const cover = `https://www.ascndrworld.com${data.cover}`;
const fmt = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });

// Tiempo de lectura aproximado (~200 palabras/min)
const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingMin = Math.max(1, Math.round(words / 200));

// Artículos relacionados: misma categoría primero, luego el resto. Máx 2.
const all = (await getCollection("blog", ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const related = [
  ...all.filter((p) => p.data.category === data.category),
  ...all.filter((p) => p.data.category !== data.category),
].slice(0, 2);

// Enlaces para compartir
const shareText = encodeURIComponent(data.title);
const shareUrl = encodeURIComponent(url);
const share = {
  whatsapp: `https://wa.me/?text=${shareText}%20${shareUrl}`,
  x: `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`,
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
};

const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.ascndrworld.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.ascndrworld.com/blog" },
        { "@type": "ListItem", "position": 3, "name": data.title, "item": url },
      ],
    },
    {
      "@type": "BlogPosting",
      "headline": data.title,
      "description": data.description,
      "image": cover,
      "url": url,
      "datePublished": data.pubDate.toISOString(),
      "dateModified": (data.updatedDate ?? data.pubDate).toISOString(),
      "inLanguage": "es-ES",
      "author": {
        "@type": "Person",
        "name": AUTHOR.name,
        "jobTitle": AUTHOR.jobTitle,
        "url": AUTHOR.url,
        "sameAs": AUTHOR.sameAs,
        "worksFor": { "@type": "Organization", "name": "Ascndr", "url": "https://www.ascndrworld.com" },
      },
      "publisher": {
        "@type": "Organization",
        "name": "Ascndr",
        "logo": { "@type": "ImageObject", "url": "https://www.ascndrworld.com/ascndr-logo.png" },
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": url },
      "articleSection": data.category,
    },
  ],
};
---
<Layout
  title={`${data.title} | Ascndr`}
  description={data.description}
  canonical={url}
  ogImage={cover}
  ogImageAlt={data.coverAlt}
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <article class="post">
    <header class="post-hero">
      <div class="post-hero-inner">
        <nav class="post-crumb" aria-label="Migas de pan">
          <a href="/">Inicio</a><span>›</span><a href="/blog">Blog</a><span>›</span><span class="post-crumb-cur">{data.category}</span>
        </nav>
        <h1 class="post-title">{data.title}</h1>
        <p class="post-lead">{data.description}</p>
        <p class="post-meta">
          Por {AUTHOR.name} <span class="post-dot">·</span> <time datetime={data.pubDate.toISOString()}>{fmt(data.pubDate)}</time> <span class="post-dot">·</span> {readingMin} min de lectura
        </p>
      </div>
    </header>

    <figure class="post-cover">
      <div class="post-cover-frame" style={data.coverBg ? `background: ${data.coverBg}` : ''}>
        <img src={data.cover} alt={data.coverAlt} fetchpriority="high" style={`object-position: ${data.coverPosition}${data.coverAspect ? `; aspect-ratio: ${data.coverAspect}` : ''}${data.coverScale ? `; transform: scale(${data.coverScale})` : ''}${data.coverFit ? `; object-fit: ${data.coverFit}` : ''}`} />
      </div>
    </figure>

    <div class="post-content">
      <Content />
    </div>

    <aside class="post-author">
      <span class="post-author-avatar" aria-hidden="true">{AUTHOR.initials}</span>
      <div class="post-author-info">
        <span class="post-author-eyebrow">Escrito por</span>
        <p class="post-author-name">{AUTHOR.name}</p>
        <p class="post-author-role">{AUTHOR.jobTitle}</p>
        <p class="post-author-bio">{AUTHOR.bio}</p>
      </div>
    </aside>

    <div class="post-share">
      <span class="post-share-label">Compartir</span>
      <div class="post-share-btns">
        <a class="post-share-btn" href={share.whatsapp} target="_blank" rel="noopener" aria-label="Compartir en WhatsApp">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.6.2-.2.3-.7.9-.8 1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.5-.4-.4-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-1 .9-1 2.3s1 2.7 1.2 2.9c.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.4M12 21.9c-1.7 0-3.4-.5-4.9-1.3l-.3-.2-3.6.9.9-3.5-.2-.4c-1-1.5-1.5-3.3-1.5-5.1C2.6 6.8 6.8 2.6 12 2.6c2.5 0 4.9 1 6.6 2.7 1.8 1.8 2.7 4.1 2.7 6.6 0 5.2-4.2 9.4-9.3 9.4M12 .7C5.8.7.7 5.8.7 12c0 2 .5 3.9 1.5 5.6L.6 23.4l5.9-1.5c1.6.9 3.5 1.4 5.4 1.4 6.2 0 11.3-5.1 11.3-11.3C23.3 5.8 18.2.7 12 .7"/></svg>
        </a>
        <a class="post-share-btn" href={share.x} target="_blank" rel="noopener" aria-label="Compartir en X">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a class="post-share-btn" href={share.linkedin} target="_blank" rel="noopener" aria-label="Compartir en LinkedIn">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13M7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0"/></svg>
        </a>
        <button class="post-share-btn" type="button" data-copy={url} aria-label="Copiar enlace">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span class="post-copied">¡Copiado!</span>
        </button>
      </div>
    </div>

    <div class="post-cta">
      <p>¿Quieres elevar tu marca?</p>
      <a href="/contacto">Iniciar proyecto ›</a>
    </div>

    {related.length > 0 && (
      <aside class="post-related">
        <h2 class="post-related-title">Sigue leyendo</h2>
        <ul class="post-related-list">
          {related.map((p) => (
            <li class="post-related-card">
              <a href={`/blog/${p.id}`}>
                <div class="post-related-media">
                  <img src={p.data.cover} alt={p.data.coverAlt} loading="lazy" />
                </div>
                <span class="post-related-cat">{p.data.category}</span>
                <h3 class="post-related-h">{p.data.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>

  <footer class="bl-footer">
    <a href="/" class="bl-footer-logo"><img src="/ascndr-logo.png" alt="Ascndr" /></a>
    <div class="bl-footer-links">
      <a href="/trabajos">Trabajos</a>
      <span class="bl-sep">·</span>
      <a href="/blog">Blog</a>
      <span class="bl-sep">·</span>
      <a href="/contacto">Contacto</a>
      <span class="bl-sep">·</span>
      <a href="https://www.instagram.com/ascndr.world" target="_blank" rel="noopener">Instagram</a>
    </div>
    <p class="bl-copy">© Ascndr 2026 · Marca Registrada</p>
  </footer>

  <script is:inline>
    document.querySelectorAll(".post-share-btn[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.getAttribute("data-copy"));
          btn.classList.add("is-copied");
          setTimeout(() => btn.classList.remove("is-copied"), 1800);
        } catch (e) {}
      });
    });
  </script>
</Layout>

<style>
  .post { background: #000; color: #fff; font-family: "Montserrat", sans-serif; }

  .post-hero { padding: 130px 40px 32px; }
  .post-hero-inner { max-width: none; margin: 0; }

  .post-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 26px; }
  .post-crumb a { color: rgba(255,255,255,0.5); text-decoration: none; transition: color .2s; }
  .post-crumb a:hover { color: #F7EFDB; }
  .post-crumb span { color: rgba(255,255,255,0.3); }
  .post-crumb .post-crumb-cur { color: rgba(247,239,219,0.85); }

  .post-title { font-size: clamp(30px, 5vw, 52px); font-weight: 700; line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 18px; }
  .post-lead { font-size: clamp(17px, 2.4vw, 20px); line-height: 1.6; color: rgba(255,255,255,0.7); font-weight: 400; margin: 0 0 24px; }
  .post-meta { font-size: 13px; color: rgba(255,255,255,0.45); margin: 0; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.08); }
  .post-dot { color: rgba(247,239,219,0.5); margin: 0 2px; }

  .post-cover { margin: 0 0 8px; padding: 0 40px; }
  .post-cover-frame { overflow: hidden; border-radius: 4px; }
  .post-cover img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center; display: block; }

  .post-content { margin: 0; padding: 48px 40px 20px; }
  .post-content :global(p) { font-size: 17px; line-height: 1.8; color: rgba(255,255,255,0.78); margin: 0 0 22px; }
  /* Primer párrafo destacado */
  .post-content :global(> p:first-of-type) { font-size: 19px; line-height: 1.7; color: rgba(255,255,255,0.92); }
  .post-content :global(h2) { font-size: clamp(22px, 3vw, 30px); font-weight: 700; color: #fff; letter-spacing: -0.01em; margin: 52px 0 18px; }
  .post-content :global(h2)::before { content: ""; display: block; width: 32px; height: 2px; background: #F7EFDB; margin-bottom: 18px; opacity: 0.8; }
  .post-content :global(h3) { font-size: 20px; font-weight: 600; color: #fff; margin: 34px 0 12px; }
  .post-content :global(ul), .post-content :global(ol) { font-size: 17px; line-height: 1.7; color: rgba(255,255,255,0.78); margin: 0 0 22px; padding-left: 1.2em; }
  .post-content :global(li) { margin-bottom: 10px; }
  .post-content :global(strong) { color: #fff; font-weight: 600; }
  .post-content :global(a) { color: #F7EFDB; text-decoration: underline; text-underline-offset: 3px; }
  .post-content :global(a:hover) { opacity: 0.75; }
  .post-content :global(blockquote) {
    margin: 36px 0; padding: 4px 0 4px 24px;
    border-left: 2px solid rgba(247,239,219,0.6);
    font-size: 21px; line-height: 1.5; font-style: italic; color: rgba(255,255,255,0.92);
  }
  .post-content :global(img) { width: 100%; height: auto; border-radius: 4px; margin: 12px 0; }

  /* Autor — firma con persona real (E-E-A-T) */
  .post-author { margin: 8px 0 0; padding: 28px 40px; display: flex; align-items: flex-start; gap: 18px; border-top: 1px solid rgba(255,255,255,0.08); }
  .post-author-avatar {
    flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: #F7EFDB; color: #000; font-weight: 700; font-size: 16px; letter-spacing: 0.04em;
  }
  .post-author-eyebrow { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
  .post-author-name { font-size: 17px; font-weight: 600; color: #fff; margin: 4px 0 2px; }
  .post-author-role { font-size: 13px; color: rgba(247,239,219,0.7); margin: 0 0 8px; }
  .post-author-bio { font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.6); margin: 0; max-width: 60ch; }

  /* Compartir */
  .post-share { margin: 0; padding: 28px 40px; display: flex; align-items: center; gap: 18px; border-top: 1px solid rgba(255,255,255,0.08); }
  .post-share-label { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.45); }
  .post-share-btns { display: flex; gap: 10px; }
  .post-share-btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
    border: 1px solid rgba(255,255,255,0.18); background: transparent; color: rgba(255,255,255,0.7);
    transition: background .2s, color .2s, border-color .2s;
  }
  .post-share-btn:hover { background: #fff; color: #000; border-color: #fff; }
  .post-copied {
    position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    background: #F7EFDB; color: #000; font-size: 10px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 4px 8px; border-radius: 3px; white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity .2s;
  }
  .post-share-btn.is-copied .post-copied { opacity: 1; }

  .post-cta { text-align: center; padding: 56px 24px 80px; }
  .post-cta p { font-size: 16px; color: rgba(255,255,255,0.5); margin: 0 0 20px; }
  .post-cta a { font-size: 13px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: #F7EFDB; text-decoration: none; border: 1.5px solid rgba(255,255,255,0.5); padding: 12px 28px; transition: background .2s, color .2s; }
  .post-cta a:hover { background: #fff; color: #000; }

  /* Artículos relacionados */
  .post-related { margin: 0; padding: 16px 40px 90px; border-top: 1px solid rgba(255,255,255,0.08); }
  .post-related-title { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(247,239,219,0.7); font-weight: 500; margin: 40px 0 26px; }
  .post-related-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px; }
  .post-related-card a { text-decoration: none; color: inherit; display: block; }
  .post-related-media { overflow: hidden; border-radius: 4px; aspect-ratio: 16 / 10; }
  .post-related-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  .post-related-card a:hover .post-related-media img { transform: scale(1.04); }
  .post-related-cat { display: block; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(247,239,219,0.7); margin: 16px 0 8px; }
  .post-related-h { font-size: 18px; font-weight: 600; line-height: 1.3; color: #fff; margin: 0; }

  .bl-footer { background: #000; color: rgba(255,255,255,0.55); padding: 60px 24px 40px; text-align: center; border-top: 1px solid rgba(255,255,255,0.06); }
  .bl-footer-logo { display: inline-block; margin-bottom: 24px; }
  .bl-footer-logo img { height: 38px; display: block; opacity: 0.95; }
  .bl-footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 18px; margin-bottom: 18px; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; }
  .bl-footer-links a { color: rgba(255,255,255,0.55); text-decoration: none; transition: color .2s; }
  .bl-footer-links a:hover { color: #fff; }
  .bl-sep { color: rgba(255,255,255,0.2); }
  .bl-copy { color: rgba(255,255,255,0.3); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin: 0; }

  @media (max-width: 768px) {
    .post-hero { padding: 110px 20px 24px; }
    .post-cover { padding: 0 20px; }
    .post-cover img { aspect-ratio: 4 / 3; }
    .post-content { padding: 36px 20px 16px; }
    .post-content :global(p), .post-content :global(ul), .post-content :global(ol) { font-size: 16px; }
    .post-content :global(> p:first-of-type) { font-size: 17px; }
    .post-author { padding: 24px 20px; }
    .post-share { padding: 24px 20px; }
    .post-related { padding: 16px 20px 70px; }
    .post-related-list { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 480px) {
    .bl-footer-links { flex-wrap: nowrap; gap: 9px; font-size: 10px; letter-spacing: 0.1em; }
  }
</style>
