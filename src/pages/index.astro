<script is:inline>
  document.addEventListener("contextmenu", function(e) {
    if (e.target.closest("img, video, .work-media, .gallery-item, .hw3-item, .ds-item, .gallery-cv-item, .lightbox-overlay")) {
      e.preventDefault();
    }
  });
  document.addEventListener("dragstart", function(e) {
    if (e.target.tagName === "IMG" || e.target.tagName === "VIDEO") {
      e.preventDefault();
    }
  });
  document.querySelectorAll("video").forEach(function(v) {
    v.setAttribute("controlslist", "nodownload");
    v.addEventListener("contextmenu", function(e){ e.preventDefault(); });
  });
</script>

<!-- ── Carruseles de móvil (proceso + testimonios): autoplay + swipe + puntos ── -->
<script is:inline>
  (function () {
    var mq = window.matchMedia("(max-width: 600px)");

    function initCarousel(trackSel, dotsSel, itemSel, dotClass, label) {
      var track = document.querySelector(trackSel);
      var dotsWrap = document.querySelector(dotsSel);
      if (!track || !dotsWrap) return;

      var items = Array.prototype.slice.call(track.querySelectorAll(itemSel));
      if (items.length < 2) return;
      var DELAY = 5000;
      var timer = null, current = 0, built = false, paused = false;

      function buildDots() {
        if (built) return;
        items.forEach(function (_, i) {
          var b = document.createElement("button");
          b.className = dotClass;
          b.type = "button";
          b.setAttribute("role", "tab");
          b.setAttribute("aria-label", label + " " + (i + 1));
          b.addEventListener("click", function () {
            pause();
            goTo(i);
          });
          dotsWrap.appendChild(b);
        });
        built = true;
      }

      function setActive(i) {
        current = i;
        var dots = dotsWrap.children;
        for (var d = 0; d < dots.length; d++) {
          dots[d].setAttribute("aria-selected", d === i ? "true" : "false");
        }
      }

      function goTo(i) {
        track.scrollTo({ left: items[i].offsetLeft - track.offsetLeft, behavior: "smooth" });
        setActive(i);
      }

      function next() { goTo((current + 1) % items.length); }

      function start() {
        if (paused || timer) return;
        timer = setInterval(next, DELAY);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function pause() { paused = true; stop(); dotsWrap.classList.add("is-paused"); }

      // Sincroniza los puntos cuando el usuario desliza a mano
      var scrollT = null;
      track.addEventListener("scroll", function () {
        if (scrollT) clearTimeout(scrollT);
        scrollT = setTimeout(function () {
          var i = Math.round(track.scrollLeft / track.clientWidth);
          if (i !== current) setActive(Math.max(0, Math.min(items.length - 1, i)));
        }, 80);
      }, { passive: true });

      // Al tocar/interactuar, se detiene el autoplay
      track.addEventListener("touchstart", function () { pause(); }, { passive: true });

      function enable() { buildDots(); dotsWrap.classList.remove("is-paused"); setActive(0); paused = false; start(); }
      function disable() { stop(); }

      return function apply() { mq.matches ? enable() : disable(); };
    }

    var carousels = [
      initCarousel(".proc-steps", ".proc-dots", ".proc-step", "proc-dot", "Paso"),
      initCarousel(".tst-grid", ".tst-dots", ".tst-item", "tst-dot", "Testimonio")
    ].filter(Boolean);

    function applyAll() { carousels.forEach(function (fn) { fn(); }); }
    applyAll();
    (mq.addEventListener ? mq.addEventListener("change", applyAll) : mq.addListener(applyAll));
  })();
</script>

