---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Ascndr | Consultoría Creativa - Branding, Lanzamientos y RRSS"
  description="Consultoría creativa en Jaén especializada en branding, dirección creativa de eventos, fotografía y gestión de redes sociales. Eleva tu marca con una visión estratégica."
  canonical="https://www.ascndrworld.com"
  ogImage="https://www.ascndrworld.com/images/og-ascndr.jpg"
>


<!-- ════ HOME ════ -->
<div id="home" class="page active">

  <!-- VÍDEO DE FONDO — muted al inicio para garantizar autoplay -->
  <video
    class="home-video-bg"
    id="homeVideoBg"
    muted
    autoplay
    loop
    playsinline
    webkit-playsinline="true"
    preload="auto"
    disablepictureinpicture
    aria-hidden="true"
    poster="/video/hero-poster.jpg"
    src="/video/hero.mp4"></video>
  <div class="home-video-overlay" aria-hidden="true"></div>
  <script is:inline>
    (function() {
      var v = document.getElementById('homeVideoBg');
      if (!v) return;
      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      function tryPlay() {
        try {
          var p = v.play();
          if (p && p.catch) p.catch(function() { /* reintentaremos en gesto */ });
        } catch (e) {}
      }
      if (v.readyState >= 2) tryPlay();
      v.addEventListener('loadedmetadata', tryPlay);
      v.addEventListener('loadeddata', tryPlay);
      v.addEventListener('canplay', tryPlay);
      // Reintenta al primer gesto si el navegador bloqueó autoplay
      function resume() {
        tryPlay();
        ['touchstart','click','scroll','keydown'].forEach(function(e){ window.removeEventListener(e, resume); });
      }
      ['touchstart','click','scroll','keydown'].forEach(function(e){
        window.addEventListener(e, resume, { passive: true });
      });
    })();
  </script>

  <!-- HERO: texto izquierda, pegado arriba tras el header -->
  <div class="home-hero-content">
    <h1 class="home-hero-title">eleva<br/>tu marca<br/>o quédate<br/>donde estás.</h1>
    <a class="home-hero-btn" href="/trabajos">VER TRABAJOS</a>
  </div>

  </div><!-- /.home-hero-wrap -->

  <!-- ════ SECCIÓN SERVICIOS — igual que "branding" en Somos ════ -->
  <section class="hs-services">
    <h2 class="hs-services-title">consultoría<br/>creativa</h2>
    <p class="hs-services-text">La identidad visual es la primera impresión que se lleva un cliente de tu marca. Trabajamos para que sea la correcta.</p>
    <p class="hs-services-text">Branding, dirección creativa, fotografía, redes sociales. Todo bajo una misma visión estratégica.</p>
    <a class="hs-services-btn" href="/contacto">INICIAR PROYECTO</a>
  </section>

  <!-- ════ SECCIÓN PROYECTOS DESTACADOS ════ -->
  <section class="hs-works">
    <a class="hs-work-item" href="/trabajos/direccion-creativa/conclave">
      <div class="hs-work-img" style="background-image:url('/images/conclave/portada-conclave2.jpg'); background-position:center 44%;"></div>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Dirección Creativa</span>
        <h3 class="hs-work-name">Cónclave</h3>
      </div>
    </a>
    <a class="hs-work-item" href="/trabajos/branding/halloweenfest">
      <div class="hs-work-img" style="background-image:url('/images/halloween-fest/pulsera-portada.jpg')"></div>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Branding</span>
        <h3 class="hs-work-name">Halloween Fest</h3>
      </div>
    </a>
    <a class="hs-work-item hs-work-item--strip" href="/trabajos/web/eventsy">
      <div class="hs-work-img" style="background-image:url('/images/eventsy/portada-carrusel.png'); background-position:center 42%;"></div>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Web</span>
        <h3 class="hs-work-name">Eventsy</h3>
      </div>
    </a>
    <a class="hs-work-item" href="/trabajos/redes-sociales/briefing">
      <div class="hs-work-img" style="background-image:url('/images/conclave/rrss-01.jpg')"></div>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Redes Sociales</span>
        <h3 class="hs-work-name">Briefing</h3>
      </div>
    </a>
    <a class="hs-work-item" href="/trabajos/fotografia/halloweenfest-fotografia">
      <div class="hs-work-img" style="background-image:url('/images/halloween-fest/portada-halloween3.jpg')"></div>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Fotografía</span>
        <h3 class="hs-work-name">Shooting 3ª edición</h3>
      </div>
    </a>
  </section>

  <!-- ════ FOOTER GLOBAL ════ -->
  <footer class="hs-footer">
    <div class="hs-footer-line"></div>
    <div class="hs-footer-middle">
      <div class="hs-footer-social">
        <a href="https://www.instagram.com/ascndr.world" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          <span class="hs-footer-ig-label">instagram</span>
        </a>
      </div>
      <div class="hs-footer-contact">
        <a href="/contacto" class="hs-footer-contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          <span>Escríbenos</span>
        </a>
        <a href="https://wa.me/34000000000" target="_blank" rel="noopener" class="hs-footer-contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
    <div class="hs-footer-line"></div>
    <nav class="hs-footer-nav">
      <a href="/trabajos">Trabajos</a>
      <span>·</span>
      <a href="/terminos">Términos</a>
      <span>·</span>
      <a href="/privacidad">Privacidad</a>
      <span>·</span>
      <a href="/contacto">Contacto</a>
    </nav>
    <p class="hs-footer-copy">© Ascndr 2026 · Marca Registrada</p>
  </footer>

  <!-- FOOTER mínimo antiguo (oculto, para SPA) -->
  <div style="display:none">
  <footer class="home-footer">
    <ul class="home-footer-nav">
      <li><a href="/trabajos">Trabajos</a></li>
      <li><span>·</span></li>
      <li><a href="/terminos">Términos</a></li>
      <li><span>·</span></li>
      <li><a href="/privacidad">Privacidad</a></li>
      <li><span>·</span></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>
    <p class="home-copyright">© Ascndr 2026 · Marca Registrada</p>
  </footer>
  </div><!-- cierre div oculto -->

</div><!-- cierre #home -->


<style>
/* ════ PROTECCIÓN CONTENIDO ════ */
img, video {
  -webkit-user-select: none;
  -webkit-touch-callout: none;
  user-select: none;
  pointer-events: none;
}
/* Restaurar pointer-events solo donde se necesita click (lightbox, galerías) */
.gallery-item img,
.hw3-item img,
.ds-item img,
.gallery-cv-item img,
.lightbox-img {
  pointer-events: auto;
}

</style>


<!-- ── Schema.org: portfolio de proyectos ── -->
<script type="application/ld+json" is:inline set:html={JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "Halloween Fest — Branding e Identidad Visual",
    "description": "Diseño de identidad visual completa para Halloween Fest Jaén: logo, carteles, pulseras, acreditaciones y dirección creativa del evento.",
    "creator": { "@type": "Organization", "name": "Ascndr", "url": "https://www.ascndrworld.com" },
    "keywords": ["branding", "identidad visual", "evento", "Halloween", "Jaén"],
    "image": "https://www.ascndrworld.com/images/halloween-fest/pulsera-portada.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "Cónclave — Dirección Creativa y Rebranding",
    "description": "Transformación completa del pub Milenio 2.0 en Cónclave: naming, identidad visual, señalética y gestión de redes sociales en Jaén.",
    "creator": { "@type": "Organization", "name": "Ascndr", "url": "https://www.ascndrworld.com" },
    "keywords": ["rebranding", "dirección creativa", "pub", "hostelería", "Jaén"],
    "image": "https://www.ascndrworld.com/images/conclave/portada-conclave2.jpg"
  },
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "3ª Ed. Halloween Fest — Fotografía de Evento",
    "description": "Cobertura fotográfica profesional de la tercera edición de Halloween Fest Jaén desde dentro del evento.",
    "creator": { "@type": "Organization", "name": "Ascndr", "url": "https://www.ascndrworld.com" },
    "keywords": ["fotografía", "cobertura evento", "Halloween", "Jaén"],
    "image": "https://www.ascndrworld.com/images/halloween-fest/portada-halloween3.jpg"
  }
])} />

<!-- ── Protección de imágenes y vídeos ── -->
<script is:inline>
  document.addEventListener("contextmenu", function(e) {
    if (e.target.closest("img, video, .work-media, .gallery-item, .hw3-item, .ds-item, .gallery-cv-item, .lightbox-overlay")) {
      e.preventDefault();
    }
  });
  document.addEventListener("dragstart", function(e) {
    if (e.target.tagName === "IMG" || e.target.tagName === "VIDEO") {
      e.preventDefault();
    }
  });
  document.querySelectorAll("video").forEach(function(v) {
    v.setAttribute("controlslist", "nodownload");
    v.addEventListener("contextmenu", function(e){ e.preventDefault(); });
  });
</script>

</Layout>

