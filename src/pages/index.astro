<script is:inline>
var qmSelected = null;

function openQModal() {
  document.getElementById('qModalBackdrop').classList.add('open');
  document.body.style.overflow = 'hidden';
  qmReset(false);
}
function closeQModal() {
  document.getElementById('qModalBackdrop').classList.remove('open');
  document.body.style.overflow = '';
}
function qModalBackdropClick(e) {
  if (e.target === document.getElementById('qModalBackdrop')) closeQModal();
}

function qmGo(n) {
  [1,2,3].forEach(function(i) {
    document.getElementById('qmstep'+i).classList.toggle('active', i===n);
    var dot = document.getElementById('qmdot'+i);
    if (dot) dot.classList.toggle('done', i < n);
  });
  // dot for current step
  var cur = document.getElementById('qmdot'+n);
  if (cur && n <= 3) cur.classList.add('done');
}

function qmSelect(el, val) {
  document.querySelectorAll('.qm-opt').forEach(function(o){ o.classList.remove('selected'); });
  el.classList.add('selected');
  qmSelected = val;
  var extra = document.getElementById('qmNoseloExtra');
  if (val === 'noselo') {
    extra.classList.add('visible');
    qmCheckStep1();
  } else {
    extra.classList.remove('visible');
    document.getElementById('qmbtn1').disabled = false;
  }
}

function qmCheckStep1() {
  if (qmSelected === 'noselo') {
    document.getElementById('qmbtn1').disabled =
      document.getElementById('qmNoseloText').value.trim().length < 5;
  }
}

function qmCheckStep2() {
  var url = document.getElementById('qmUrl').value.trim();
  var email = document.getElementById('qmEmail').value.trim();
  document.getElementById('qmbtn2').disabled = !(url.length > 2 && email.includes('@'));
}

function qmSend() {
  // Recoger datos y enviar al mismo endpoint que el formulario de contacto
  var tipo = qmSelected || '';
  var noselo = document.getElementById('qmNoseloText').value.trim();
  var url = document.getElementById('qmUrl').value.trim();
  var email = document.getElementById('qmEmail').value.trim();
  var consulta = tipo === 'noselo' ? ('No sé / orientación: ' + noselo) : tipo;

  // Enviar via fetch al mismo endpoint de Formspree/EmailJS que usa el drawer
  var endpoint = document.getElementById('drawerForm') ?
    document.getElementById('drawerForm').action : null;

  // Si hay endpoint real lo usamos, si no simplemente mostramos confirmación
  if (endpoint) {
    var body = new FormData();
    body.append('tipo', consulta);
    body.append('web_instagram', url);
    body.append('email', email);
    fetch(endpoint, { method: 'POST', body: body, headers: { 'Accept': 'application/json' } })
      .catch(function(){});
  }

  qmGo(3);
}

function qmReset(reopen) {
  qmSelected = null;
  document.querySelectorAll('.qm-opt').forEach(function(o){ o.classList.remove('selected'); });
  document.getElementById('qmNoseloExtra').classList.remove('visible');
  document.getElementById('qmNoseloText').value = '';
  document.getElementById('qmbtn1').disabled = true;
  document.getElementById('qmUrl').value = '';
  document.getElementById('qmEmail').value = '';
  document.getElementById('qmbtn2').disabled = true;
  [1,2,3].forEach(function(i){
    var d = document.getElementById('qmdot'+i);
    if (d) d.classList.remove('done');
  });
  qmGo(1);
}
</script>

<!-- ── SEO: canonical dinámico por sección ── -->
<script is:inline>
(function(){
  var sectionCanonicals = {
    "/":                              "https://ascndrworld.com/",
    "/trabajos":                      "https://ascndrworld.com/trabajos",
    "/trabajos/branding":             "https://ascndrworld.com/trabajos/branding",
    "/trabajos/redes-sociales":       "https://ascndrworld.com/trabajos/redes-sociales",
    "/trabajos/fotografia":           "https://ascndrworld.com/trabajos/fotografia",
    "/trabajos/direccion-creativa":   "https://ascndrworld.com/trabajos/direccion-creativa",
    "/terminos":                      "https://ascndrworld.com/terminos",
    "/privacidad":                    "https://ascndrworld.com/privacidad"
  };
  function updateCanonical() {
    var path = window.location.pathname.replace(/\/+$/, "") || "/";
    var url = sectionCanonicals[path] || ("https://ascndrworld.com" + path);
    var tag = document.querySelector("link[rel='canonical']");
    if (tag) tag.setAttribute("href", url);
  }
  updateCanonical();
  var _orig = history.pushState;
  history.pushState = function() { _orig.apply(this, arguments); updateCanonical(); };
  window.addEventListener("popstate", updateCanonical);
})();
</script>

