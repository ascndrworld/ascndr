<!-- ── Carruseles (proceso = todos los anchos; testimonios = solo móvil): autoplay +
     swipe/scroll + puntos (+ flechas en proceso) ── -->
<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function initCarousel(trackSel, dotsSel, itemSel, dotClass, label, enableMq, arrowSel) {
      var track = document.querySelector(trackSel);
      var dotsWrap = document.querySelector(dotsSel);
      if (!track || !dotsWrap) return;

      var items = Array.prototype.slice.call(track.querySelectorAll(itemSel));
      if (items.length < 2) return;
      var DELAY = 5000;
      var timer = null, current = 0, built = false, paused = false;

      function buildDots() {
        if (built) return;
        items.forEach(function (_, i) {
          var b = document.createElement("button");
          b.className = dotClass;
          b.type = "button";
          b.setAttribute("role", "tab");
          b.setAttribute("aria-label", label + " " + (i + 1));
          b.addEventListener("click", function () {
            pause();
            goTo(i);
          });
          dotsWrap.appendChild(b);
        });
        built = true;
      }

      function setActive(i) {
        current = i;
        var dots = dotsWrap.children;
        for (var d = 0; d < dots.length; d++) {
          dots[d].setAttribute("aria-selected", d === i ? "true" : "false");
        }
      }

      function goTo(i) {
        track.scrollTo({ left: items[i].offsetLeft - track.offsetLeft, behavior: "smooth" });
        setActive(i);
      }

      function next() { goTo((current + 1) % items.length); }

      function start() {
        if (paused || timer || reduce) return;
        timer = setInterval(next, DELAY);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function pause() { paused = true; stop(); dotsWrap.classList.add("is-paused"); }

      // Sincroniza los puntos EN VIVO mientras el usuario desliza/scrollea
      // (rAF en vez de debounce: el indicador cambia al cruzar la mitad, sin retardo)
      var raf = null;
      track.addEventListener("scroll", function () {
        if (raf) return;
        raf = requestAnimationFrame(function () {
          raf = null;
          var i = Math.round(track.scrollLeft / track.clientWidth);
          i = Math.max(0, Math.min(items.length - 1, i));
          if (i !== current) setActive(i);
        });
      }, { passive: true });

      // Al tocar/interactuar, se detiene el autoplay
      track.addEventListener("touchstart", function () { pause(); }, { passive: true });

      // Flechas (opcional, p. ej. en proceso): saltan con wrap-around
      if (arrowSel) {
        Array.prototype.forEach.call(document.querySelectorAll(arrowSel), function (btn) {
          btn.addEventListener("click", function () {
            pause();
            var dir = parseInt(btn.getAttribute("data-dir"), 10) || 1;
            goTo((current + dir + items.length) % items.length);
          });
        });
      }

      function enable() { buildDots(); dotsWrap.classList.remove("is-paused"); setActive(0); paused = false; start(); }
      function disable() { stop(); }

      return function apply() { enableMq.matches ? enable() : disable(); };
    }

    var procMq = window.matchMedia("(min-width: 0px)");   // proceso: carrusel en todos los anchos
    var tstMq = window.matchMedia("(max-width: 600px)");  // testimonios: solo móvil

    var apply = [
      initCarousel(".proc-viewport", ".proc-dots", ".proc-panel", "proc-dot", "Paso", procMq, ".proc-arrow"),
      initCarousel(".tst-grid", ".tst-dots", ".tst-item", "tst-dot", "Testimonio", tstMq)
    ].filter(Boolean);

    function applyAll() { apply.forEach(function (fn) { fn(); }); }
    applyAll();
    (tstMq.addEventListener ? tstMq.addEventListener("change", applyAll) : tstMq.addListener(applyAll));
  })();
</script>

<!-- ── "Servicios": la cruz se dibuja + iconos pop + cascada (rejilla 2×2, PC) ── -->
<script is:inline>
  (function () {
    var svc = document.getElementById("servicios");
    if (!svc) return;
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    svc.classList.add("svc-anim");
    if (!("IntersectionObserver" in window)) { svc.classList.add("is-in"); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { svc.classList.add("is-in"); io.disconnect(); }
      });
    }, { threshold: 0.35 });
    io.observe(svc);
  })();
</script>

</Layout>

