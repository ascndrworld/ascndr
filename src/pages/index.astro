    document.getElementById("modalSuccess").classList.remove("show");
    document.getElementById("modalOverlay").classList.add("open");
    document.body.style.overflow = "hidden";
    window.scrollTo(0,0);
  }
  function closeModal() {
    document.getElementById("modalOverlay").classList.remove("open");
    document.body.style.overflow = "";
    /* Si la URL quedó en /contacto, la revertimos a la página visible */
    if (window.location.pathname.replace(/\/+$/, "") === "/contacto") {
      const activePage = document.querySelector(".page.active");
      const id = activePage ? activePage.id : "home";
      const path = PAGE_ROUTES[id] || "/";
      history.replaceState({ page: id }, "", path);
    }
  }
  async function sendModal() {
    const btn      = document.getElementById("mSendBtn");
    const errorEl  = document.getElementById("mError");
    const nombre   = document.getElementById("mNombre").value.trim();
    const email    = document.getElementById("mEmail").value.trim();
    const telefono = document.getElementById("mTelefono").value.trim();
    const honeypot = document.getElementById("mWebsite").value;

    if (honeypot) {
      document.getElementById("modalForm").style.display = "none";
      document.getElementById("modalSuccess").classList.add("show");
      setTimeout(closeModal, 3000);
      return;
    }

    errorEl.style.display = "none";
    if (!nombre || !email) {
      errorEl.textContent = "Por favor completa tu nombre y email.";
      errorEl.style.display = "block";
      return;
    }
    if (!isValidEmail(email)) {
      errorEl.textContent = "El email no parece válido. Revísalo.";
      errorEl.style.display = "block";
      return;
    }

    const btnTextOriginal = btn.innerHTML;
    btn.disabled = true;
    btn.style.opacity = "0.6";
    btn.style.cursor = "wait";
    btn.innerHTML = "Enviando...";

    /* El modal siempre usa la plantilla B (contacto genérico) */
    const params = {
      name:     nombre,
      email:    email,
      phone:    telefono || "No facilitado",
      consulta: "Sin consulta previa",
      reply_to: email
    };

    try {
      await sendEmail(EMAILJS_TEMPLATE_B, params);
      document.getElementById("modalForm").style.display = "none";
      document.getElementById("modalSuccess").classList.add("show");
      setTimeout(closeModal, 3000);
    } catch (err) {
      console.error("EmailJS error:", err);
      errorEl.textContent = "No hemos podido enviar el mensaje. Inténtalo de nuevo en unos segundos.";
      errorEl.style.display = "block";
      btn.disabled = false;
      btn.style.opacity = "";
      btn.style.cursor = "";
      btn.innerHTML = btnTextOriginal;
    }
  }

  document.addEventListener("keydown", e => {
    if (e.key === "Escape") { closeDrawer(); closeModal(); }
  });

  /* ════ COOKIE BANNER ════ */
  const COOKIE_KEY = "ascndr_cookie_consent";

  function initCookieBanner() {
    try {
      if (localStorage.getItem(COOKIE_KEY)) return; // ya decidido, no mostrar
    } catch (e) { /* localStorage bloqueado → mostrar igualmente */ }

    const banner = document.getElementById("cookieBanner");
    if (!banner) return;
    // pequeño delay para que entre después del halo de bienvenida
    setTimeout(() => banner.classList.add("visible"), 1200);
  }

  function handleCookie(choice) {
    try { localStorage.setItem(COOKIE_KEY, choice); } catch (e) {}
    const banner = document.getElementById("cookieBanner");
    if (!banner) return;
    banner.classList.remove("visible");
    banner.classList.add("hiding");
    setTimeout(() => banner.remove(), 600);
  }

  window.addEventListener("load", initCookieBanner);

</script>
