  async function sendDrawer() {
    const btn=document.getElementById("drawerSendBtn"),errorEl=document.getElementById("drawerError");
    const nombre=document.getElementById("drawerNombre").value.trim(),email=document.getElementById("drawerEmail").value.trim();
    const telefono=document.getElementById("drawerTelefono").value.trim(),consulta=document.getElementById("drawerConsulta").value.trim();
    const honeypot=document.getElementById("drawerWebsite").value;
    if(honeypot){document.getElementById("drawerForm").style.display="none";document.getElementById("drawerSuccess").classList.add("show");setTimeout(closeDrawer,3000);return;}
    errorEl.style.display="none";
    if(!nombre||!email){errorEl.textContent="Por favor completa tu nombre y email.";errorEl.style.display="block";return;}
    if(!isValidEmail(email)){errorEl.textContent="El email no parece válido. Revísalo.";errorEl.style.display="block";return;}
    const orig=btn.innerHTML; btn.disabled=true;btn.style.opacity="0.6";btn.style.cursor="wait";btn.innerHTML="Enviando...";
    try{
      const res=await fetch(`/api/send?nombre=${encodeURIComponent(nombre)}&email=${encodeURIComponent(email)}&telefono=${encodeURIComponent(telefono||'')}&consulta=${encodeURIComponent(consulta||'')}`,{method:'POST'});
      if(!res.ok) throw new Error('Error');
      document.getElementById("drawerForm").style.display="none";
      document.getElementById("drawerSuccess").classList.add("show");
      setTimeout(closeDrawer,3000);
    }catch(err){
      errorEl.textContent="No hemos podido enviar el mensaje. Inténtalo de nuevo en unos segundos.";
      errorEl.style.display="block";btn.disabled=false;btn.style.opacity="";btn.style.cursor="";btn.innerHTML=orig;
    }
  }

