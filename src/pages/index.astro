/*
  GRID — proporciones reales con vw
  Foto vertical 2:3 en 4/12 cols = 33.3vw ancho → altura ideal = 50vw
  Foto horizontal 3:2 en 12/12 = 100vw ancho → altura ideal = 33vw (la hacemos 40vw para que se vea con más presencia)
  Tall × 2 filas verticales = 100vw (2 × 50vw)
*/
.hw3-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-template-rows:
    40vw    /* F1 — horizontal grande */
    50vw    /* F2 — tall izq + 2 vert der */
    50vw    /* F3 — tall cont + 2 vert der */
    50vw    /* F4 — 3 verticales */
    50vw    /* F5 — 2 vert izq + tall der */
    50vw;   /* F6 — wide8 + tall cont */
