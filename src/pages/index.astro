  color: rgba(247, 239, 219, 0.14);
  margin: 0 0 clamp(8px, 1.4vw, 18px);
}
.proc-name {
  font-size: clamp(30px, 4.4vw, 60px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.02em;
  margin: 0 0 16px;
  color: #F7EFDB;
}
.proc-desc {
  font-size: clamp(15px, 1.2vw, 17px);
  line-height: 1.7;
  color: rgba(247, 239, 219, 0.6);
  max-width: 42ch;
  margin: 0;
}
.tst-dots { display: none; }
.proc-dots { display: flex; justify-content: center; align-items: center; gap: 13px; }
.proc-controls { display: flex; align-items: center; justify-content: center; }
.proc-arrow { display: none; }  /* flechas solo en PC */

/* PC: carrusel (slide como en móvil) — una tarjeta por pantalla con número gigante
   + texto; autoplay + flechas + puntos + swipe/scroll horizontal. Sin scroll fijado. */
@media (min-width: 769px) {
  .proc-h { padding: clamp(96px, 12vh, 168px) clamp(24px, 5vw, 88px); }
  .proc-pin { position: static; height: auto; }
  .proc-sticky { position: static; height: auto; display: block; overflow: visible; padding: 0; }
  .proc-sticky .proc-head { position: static; margin: 0 0 clamp(40px, 5vw, 72px); }

  .proc-viewport {
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .proc-viewport::-webkit-scrollbar { display: none; }
  .proc-track { display: flex; list-style: none; margin: 0; padding: 0; width: 100%; }
  .proc-panel {
    flex: 0 0 100%; scroll-snap-align: center; box-sizing: border-box;
    display: flex; align-items: center; gap: clamp(36px, 5vw, 96px);
    min-height: clamp(320px, 44vh, 460px);
  }
  .proc-num {
    flex: 0 0 auto; margin: 0;
    font-size: clamp(140px, 22vw, 340px); line-height: 0.8;
    color: rgba(247, 239, 219, 0.92);
  }
  .proc-text { max-width: 46ch; }
  .proc-name { font-size: clamp(34px, 4vw, 64px); margin: 0 0 18px; }
  .proc-desc { font-size: clamp(15px, 1.15vw, 18px); max-width: 42ch; }

  /* flechas + puntos centrados debajo */
  .proc-controls { gap: clamp(24px, 2.5vw, 40px); margin-top: clamp(28px, 3.5vw, 52px); }
  .proc-arrow {
    display: inline-flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border-radius: 50%; padding: 0;
    border: 1px solid rgba(247, 239, 219, 0.18); background: transparent;
    color: #F7EFDB; cursor: pointer;
    transition: border-color 0.4s ease, background 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .proc-arrow svg {
    width: 19px; height: 19px; display: block;
    fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .proc-arrow:hover { border-color: rgba(247, 239, 219, 0.85); background: rgba(247, 239, 219, 0.05); }
  .proc-arrow[data-dir="1"]:hover svg  { transform: translateX(3px); }
  .proc-arrow[data-dir="-1"]:hover svg { transform: translateX(-3px); }
  .proc-arrow:active { transform: scale(0.93); }
  .proc-arrow:focus-visible { outline: none; border-color: #F7EFDB; box-shadow: 0 0 0 4px rgba(247, 239, 219, 0.14); }
}

/* Móvil/tablet ≤768: sin pin — swipe horizontal nativo */
@media (max-width: 768px) {
  .proc-h { padding: clamp(72px, 9vw, 120px) 0; }
  .proc-pin { height: auto; }
  .proc-sticky { position: static; height: auto; display: block; }
  .proc-sticky .proc-head { position: static; padding: 0 10px; margin: 0 0 clamp(20px, 4vw, 36px); }
  .proc-viewport {
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .proc-viewport::-webkit-scrollbar { display: none; }
  .proc-track { display: flex; list-style: none; margin: 0; padding: 0; width: max-content; }
  /* una tarjeta por pantalla (slide), igual que el carrusel que teníamos antes */
  .proc-panel {
    flex: 0 0 100vw; scroll-snap-align: center; box-sizing: border-box; padding: 0 16px;
  }
  .proc-num { font-size: clamp(64px, 22vw, 120px); }
  .proc-name { font-size: clamp(26px, 8.5vw, 38px); }  /* igual que "Branding" en servicios */
  .proc-progress { display: none; }
}

