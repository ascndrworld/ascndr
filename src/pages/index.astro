      <p class="drawer-sub">¿Tienes una idea en mente? Cuéntanos qué necesitas y te atenderemos lo antes posible.</p>

      <div class="consulta-box">
        <label class="consulta-box-label">Tu consulta</label>
        <textarea id="drawerConsulta" placeholder='"asesoría sobre rrss"' maxlength="150"></textarea>
      </div>

      <div class="d-field-group">
        <label class="d-field-label">Nombre <em>*</em></label>
        <div class="d-input-wrap">
          <span class="d-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          </span>
          <input class="d-input" id="drawerNombre" type="text" placeholder="Tu nombre"/>
        </div>
      </div>

      <div class="d-field-group">
        <label class="d-field-label">Email <em>*</em></label>
        <div class="d-input-wrap">
          <span class="d-icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          </span>
          <input class="d-input" id="drawerEmail" type="email" placeholder="tu@email.com"/>
        </div>
      </div>

      <div class="d-field-group">
        <label class="d-field-label">Teléfono <em>opcional</em></label>
        <div class="d-input-wrap">
          <span class="d-icon">
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <input class="d-input" id="drawerTelefono" type="tel" placeholder="+34 600 000 000"/>
        </div>
      </div>

