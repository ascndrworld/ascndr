---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Ascndr | Consultoría Creativa - Branding, Lanzamientos y RRSS"
  description="Consultoría creativa en Jaén especializada en branding, dirección creativa de eventos, fotografía y gestión de redes sociales. Eleva tu marca con una visión estratégica."
  canonical="https://www.ascndrworld.com"
  ogImage="https://www.ascndrworld.com/images/og-ascndr.jpg"
>


<!-- ════ HOME ════ -->
<div id="home" class="page active">

  <!-- VÍDEO DE FONDO — muted al inicio para garantizar autoplay -->
  <video
    class="home-video-bg"
    id="homeVideoBg"
    muted
    autoplay
    loop
    playsinline
    webkit-playsinline="true"
    preload="metadata"
    disablepictureinpicture
    aria-hidden="true"
    poster="/video/hero-poster.jpg"
    src="/video/hero.mp4"></video>
  <div class="home-video-overlay" aria-hidden="true"></div>
  <script is:inline>
    (function() {
      var v = document.getElementById('homeVideoBg');
      if (!v) return;
      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      function tryPlay() {
        try {
          var p = v.play();
          if (p && p.catch) p.catch(function() { /* reintentaremos en gesto */ });
        } catch (e) {}
      }
      if (v.readyState >= 2) tryPlay();
      v.addEventListener('loadedmetadata', tryPlay);
      v.addEventListener('loadeddata', tryPlay);
      v.addEventListener('canplay', tryPlay);
      // Reintenta al primer gesto si el navegador bloqueó autoplay
      function resume() {
        tryPlay();
        ['touchstart','click','scroll','keydown'].forEach(function(e){ window.removeEventListener(e, resume); });
      }
      ['touchstart','click','scroll','keydown'].forEach(function(e){
        window.addEventListener(e, resume, { passive: true });
      });
    })();
  </script>

  <!-- HERO: texto izquierda, pegado arriba tras el header -->
  <div class="home-hero-content">
    <h1 class="home-hero-title">eleva<br/>tu marca<br/>o quédate<br/>donde estás.</h1>
    <a class="home-hero-btn" href="/trabajos">VER TRABAJOS</a>
  </div>

  </div><!-- /.home-hero-wrap -->

  <!-- ════ SECCIÓN SERVICIOS — igual que "branding" en Somos ════ -->
  <section class="hs-services">
    <h2 class="hs-services-title">consultoría<br/>creativa</h2>
    <p class="hs-services-text">La identidad visual es la primera impresión que se lleva un cliente de tu marca. Trabajamos para que sea la correcta.</p>
    <p class="hs-services-text">Branding, dirección creativa, web, redes sociales. Todo bajo una misma visión estratégica.</p>
    <a class="hs-services-btn" href="/contacto">INICIAR PROYECTO</a>
  </section>

  <!-- ════ SECCIÓN SERVICIOS DESGLOSADOS ════ -->
  <section class="svc" id="servicios">
    <div class="svc-head">
      <span class="svc-eyebrow">QUÉ HACEMOS</span>
      <h2 class="svc-title">servicios</h2>
    </div>
    <div class="svc-grid">
      <article class="svc-item">
        <h3 class="svc-name">Branding</h3>
        <p class="svc-desc">Naming, logo, tipografías, color y el sistema visual completo que hace que tu marca se reconozca y se recuerde.</p>
      </article>
      <article class="svc-item">
        <h3 class="svc-name">Dirección Creativa</h3>
        <p class="svc-desc">La idea que lo unifica todo. Eventos, lanzamientos y campañas donde cada pieza cuenta la misma historia.</p>
      </article>
      <article class="svc-item">
        <h3 class="svc-name">Web</h3>
        <p class="svc-desc">Diseño y desarrollo de webs y productos digitales a medida: UX/UI y código, pensados para reflejar tu marca y funcionar de verdad.</p>
      </article>
      <article class="svc-item">
        <h3 class="svc-name">Redes Sociales</h3>
        <p class="svc-desc">Estrategia y contenido con intención: un feed reconocible que atrae, genera confianza y convierte.</p>
      </article>
    </div>
  </section>

  <!-- ════ SECCIÓN PROYECTOS DESTACADOS ════ -->
  <div class="works-head">
    <span class="svc-eyebrow">PROYECTOS</span>
    <h2 class="svc-title">trabajos</h2>
  </div>
  <section class="hs-works">
    <a class="hs-work-item" href="/trabajos/direccion-creativa/conclave">
      <img class="hs-work-img" src="/images/conclave/portada-conclave2.jpg" alt="Cónclave — Rebranding y dirección creativa de pub en Jaén por Ascndr" loading="lazy" style="object-position:center 44%;"/>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Dirección Creativa</span>
        <h3 class="hs-work-name">Cónclave</h3>
      </div>
    </a>
    <a class="hs-work-item" href="/trabajos/branding/halloweenfest">
      <img class="hs-work-img" src="/images/halloween-fest/pulsera-portada.jpg" alt="Halloween Fest — Branding e identidad visual de evento en Los Villares, Jaén" loading="lazy"/>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Branding</span>
        <h3 class="hs-work-name">Halloween Fest</h3>
      </div>
    </a>
    <a class="hs-work-item" href="/trabajos/redes-sociales/briefing">
      <img class="hs-work-img" src="/images/conclave/rrss-01.jpg" alt="Briefing — Gestión de redes sociales y contenido para Cónclave en Jaén" loading="lazy"/>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Redes Sociales</span>
        <h3 class="hs-work-name">Briefing</h3>
      </div>
    </a>
    <a class="hs-work-item" href="/trabajos/web/eventsy">
      <img class="hs-work-img" src="/images/eventsy/portada-carrusel.png" alt="Eventsy — Diseño de plataforma web y app de gestión de eventos por Ascndr" loading="lazy"/>
      <div class="hs-work-overlay">
        <span class="hs-work-cat">Web</span>
        <h3 class="hs-work-name">Eventsy</h3>
      </div>
    </a>
  </section>

  <!-- ════ CÓMO TRABAJAMOS — proceso ════ -->
  <section class="proc" id="proceso">
    <div class="proc-head">
      <span class="proc-eyebrow">CÓMO TRABAJAMOS</span>
      <h2 class="proc-title">el proceso</h2>
    </div>
    <ol class="proc-steps">
      <li class="proc-step">
        <span class="proc-num">01</span>
        <h3 class="proc-name">Hablamos</h3>
        <p class="proc-desc">Nos cuentas tu proyecto y entendemos tu negocio, tu público y a dónde quieres llegar.</p>
      </li>
      <li class="proc-step">
        <span class="proc-num">02</span>
        <h3 class="proc-name">Estrategia</h3>
        <p class="proc-desc">Definimos el rumbo: posicionamiento, concepto y qué necesita tu marca para destacar.</p>
      </li>
      <li class="proc-step">
        <span class="proc-num">03</span>
        <h3 class="proc-name">Creamos</h3>
        <p class="proc-desc">Diseñamos la identidad, las piezas y el contenido, todo bajo una misma visión.</p>
      </li>
      <li class="proc-step">
        <span class="proc-num">04</span>
        <h3 class="proc-name">Lanzamos</h3>
        <p class="proc-desc">Ponemos tu marca en el mundo y te dejamos las herramientas para mantenerla.</p>
      </li>
    </ol>
    <div class="proc-dots" role="tablist" aria-label="Navegación del proceso"></div>
  </section>

  <!-- ════ TESTIMONIOS ════ -->
  <section class="tst" id="testimonios">
    <div class="tst-head">
      <span class="svc-eyebrow">TESTIMONIOS</span>
      <h2 class="svc-title">confían en nosotros</h2>
    </div>
    <div class="tst-grid">
      <figure class="tst-item">
        <blockquote class="tst-quote">Llevo muchos años trabajando en la noche y pensaba que un cambio tan drástico no iba a funcionar, pero han rejuvenecido mi negocio. Tomé la decisión correcta: ahora mi local vuelve a ser el punto de encuentro en el pueblo.</blockquote>
        <figcaption class="tst-author">
          <span class="tst-name">Lorenzo Hidalgo</span>
          <span class="tst-role">Dueño de Pub Milenio · +26 años en el sector</span>
        </figcaption>
      </figure>
      <figure class="tst-item">
        <blockquote class="tst-quote">En las dos primeras ediciones se nos veía como un evento poco profesional. Hace 2 años que trabajamos juntos y nuestro evento ahora crea comunidad y llega a más gente en cada edición.</blockquote>
        <figcaption class="tst-author">
          <span class="tst-name">Luis Ramírez</span>
          <span class="tst-role">Founder de Halloween Fest · 4 ediciones consecutivas</span>
        </figcaption>
      </figure>
      <figure class="tst-item">
        <blockquote class="tst-quote">Quería crear una aplicación web seria desde el primer día. Nos orientaron sobre variables y herramientas que desconocíamos. Nuestra marca está presente entre promotores de eventos.</blockquote>
        <figcaption class="tst-author">
          <span class="tst-name">Juan Delgado</span>
          <span class="tst-role">CEO y Co-Founder de Eventsy</span>
        </figcaption>
      </figure>
    </div>
    <div class="tst-dots" role="tablist" aria-label="Navegación de testimonios"></div>
  </section>

  <!-- ════ CTA DE CIERRE ════ -->
  <section class="cta" id="empecemos">
    <h2 class="cta-title">¿elevamos<br/>tu marca?</h2>
    <p class="cta-text">Cuéntanos qué tienes en mente. Te respondemos en menos de 24h.</p>
    <a class="cta-btn" href="/contacto">INICIAR PROYECTO</a>
  </section>

  <!-- ════ FOOTER GLOBAL ════ -->
  <footer class="hs-footer">
    <div class="hs-footer-line"></div>
    <div class="hs-footer-middle">
      <div class="hs-footer-social">
        <a href="https://www.instagram.com/ascndr.world" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          <span class="hs-footer-ig-label">instagram</span>
        </a>
      </div>
      <div class="hs-footer-contact">
        <a href="/contacto" class="hs-footer-contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          <span>Escríbenos</span>
        </a>
        <a href="https://wa.me/34667241262" target="_blank" rel="noopener" class="hs-footer-contact-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
    <div class="hs-footer-line"></div>
    <nav class="hs-footer-nav">
      <a href="/trabajos">Trabajos</a>
      <span>·</span>
      <a href="/blog">Blog</a>
      <span>·</span>
      <a href="/terminos">Términos</a>
      <span>·</span>
      <a href="/privacidad">Privacidad</a>
      <span>·</span>
      <a href="/contacto">Contacto</a>
    </nav>
    <p class="hs-footer-copy">© Ascndr 2026 · Marca Registrada</p>
  </footer>


</div><!-- cierre #home -->


<style>
/* ════ PROTECCIÓN CONTENIDO ════ */
img, video {
  -webkit-user-select: none;
  -webkit-touch-callout: none;
  user-select: none;
  pointer-events: none;
}
/* Restaurar pointer-events solo donde se necesita click (lightbox, galerías) */
.gallery-item img,
.hw3-item img,
.ds-item img,
.gallery-cv-item img,
.lightbox-img {
  pointer-events: auto;
}

/* ════════════════════════════════════════════════════════
   SECCIONES LANDING — Servicios, Antes/Después, Proceso, CTA
   ════════════════════════════════════════════════════════ */
.svc, .proc, .cta, .works-head {
  background: #000;
  color: #F7EFDB;
  font-family: "Montserrat", sans-serif;
}
/* Menos espacio arriba: pegadas a la sección anterior */
.svc  { padding: clamp(24px, 3vw, 44px) 0 clamp(44px, 5vw, 72px); }
.proc { padding: clamp(72px, 9vw, 120px) 10px clamp(72px, 9vw, 116px); }
.works-head { padding: clamp(48px, 6vw, 88px) 10px clamp(24px, 3vw, 36px); text-align: right; }
/* La intro "consultoría creativa" deja menos hueco abajo para juntarse con servicios */
.hs-services { padding-bottom: clamp(40px, 5vw, 64px); }

/* Cabeceras de sección compartidas */
.svc-eyebrow, .proc-eyebrow {
  display: block;
  font-size: 11px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: rgba(247, 239, 219, 0.5);
  margin-bottom: 18px;
  font-weight: 500;
}
.svc-title, .proc-title {
  font-size: clamp(40px, 6vw, 72px);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -2px;
  text-transform: lowercase;
  margin: 0;
}

/* ── SERVICIOS DESGLOSADOS ── */
.svc-head { padding: 0 10px; margin: 0 0 40px; }
/* Rejilla a ancho completo: solo separadores entre columnas, sin líneas
   arriba/abajo ni en los lados. Las tarjetas igualan altura (stretch) para
   que los separadores y las descripciones queden alineados. */
.svc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.svc-item {
  background: #000;
  padding: 4px 32px;
  border-left: 1px solid rgba(247, 239, 219, 0.14);
  transition: background 0.3s ease;
}
.svc-item:first-child { border-left: none; padding-left: 10px; }
.svc-item:hover { background: #0b0b0b; }
.svc-name {
  font-size: 22px;
  font-weight: 700;
  margin: 0 0 12px;
  letter-spacing: -0.01em;
  min-height: 2.3em;   /* reserva 2 líneas: todas las descripciones quedan a la misma altura */
}
.svc-desc {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(247, 239, 219, 0.6);
  margin: 0;
}

/* ── CÓMO TRABAJAMOS — cabecera alineada a la izquierda ── */
.proc-head { margin: 0 0 48px; text-align: left; }
.proc-steps {
  list-style: none;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}
.proc-step {
  padding-top: 24px;
  border-top: 1px solid rgba(247, 239, 219, 0.18);
}
.proc-num {
  font-size: 34px;
  font-weight: 800;
  letter-spacing: -1px;
  color: rgba(247, 239, 219, 0.25);
}
.proc-name {
  font-size: 19px;
  font-weight: 700;
  margin: 14px 0 10px;
}
.proc-desc {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(247, 239, 219, 0.6);
  margin: 0;
}
/* Marcadores de carrusel — solo visibles en móvil (ver responsive) */
.proc-dots, .tst-dots { display: none; }

/* ── CTA DE CIERRE ── */
.cta {
  text-align: center;
  padding-top: clamp(96px, 12vw, 160px);
  padding-bottom: clamp(96px, 12vw, 160px);
  border-top: 1px solid rgba(247, 239, 219, 0.08);
}
.cta-title {
  font-size: clamp(48px, 8vw, 96px);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -3px;
  text-transform: lowercase;
  margin: 0 0 24px;
}
.cta-text {
  font-size: 17px;
  line-height: 1.5;
  color: rgba(247, 239, 219, 0.6);
  margin: 0 auto 40px;
  max-width: 440px;
}
.cta-btn {
  display: inline-block;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #000;
  background: #F7EFDB;
  text-decoration: none;
  padding: 16px 40px;
  border: 2px solid #F7EFDB;
  transition: background 0.25s ease, color 0.25s ease;
}
.cta-btn:hover { background: transparent; color: #F7EFDB; }

/* ── TESTIMONIOS ── */
.tst {
  background: #000;
  color: #F7EFDB;
  font-family: "Montserrat", sans-serif;
  padding: clamp(72px, 9vw, 120px) 10px;
}
.tst-head { margin: 0 0 clamp(40px, 5vw, 64px); text-align: right; }
.tst-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.tst-item {
  margin: 0;
  display: flex;
  flex-direction: column;
  padding: 0 clamp(24px, 2.5vw, 40px);
  border-left: 1px solid rgba(247, 239, 219, 0.18);
}
.tst-item:first-child { border-left: none; padding-left: 10px; }
.tst-quote {
  font-size: clamp(16px, 1.3vw, 18px);
  line-height: 1.6;
  color: rgba(247, 239, 219, 0.9);
  font-weight: 400;
  margin: 0 0 28px;
}
.tst-quote::before {
  content: "\201C";
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 52px;
  line-height: 0.5;
  color: rgba(247, 239, 219, 0.35);
  margin-bottom: 16px;
}
.tst-author {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin-top: auto;
}
.tst-name { font-size: 15px; font-weight: 700; color: #fff; }
.tst-role { font-size: 12px; letter-spacing: 0.03em; color: rgba(247, 239, 219, 0.5); }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .svc-grid { grid-template-columns: 1fr 1fr; }
  .svc-item:nth-child(odd) { border-left: none; }
  .svc-item:nth-child(n+3) { border-top: 1px solid rgba(247, 239, 219, 0.14); }
  .proc-steps { grid-template-columns: 1fr 1fr; gap: 28px 24px; }
  .tst-grid { grid-template-columns: 1fr; }
  .tst-item { border-left: none; border-top: 1px solid rgba(247, 239, 219, 0.14); padding: 28px 0 0; }
  .tst-item:first-child { border-top: none; padding: 0; }
  .tst-head { text-align: left; }
}
@media (max-width: 600px) {
  .svc-grid { grid-template-columns: 1fr; }
  .svc-item { border-left: none; border-top: 1px solid rgba(247, 239, 219, 0.14); padding: 28px 20px; }
  .svc-item:first-child { border-top: none; padding-left: 20px; }
  .svc-name { min-height: 0; }
  .works-head { text-align: left; }

  /* Proceso → carrusel de un paso (autoplay + swipe) */
  .proc-steps {
    display: flex;
    grid-template-columns: none;
    gap: 0;
    margin: 0 -10px;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .proc-steps::-webkit-scrollbar { display: none; }
  .proc-step {
    flex: 0 0 100%;
    box-sizing: border-box;
    scroll-snap-align: center;
    border-top: none;
    padding: 0 10px;
  }
  .proc-num { font-size: 44px; }
  .proc-name { font-size: 22px; }
  .proc-desc { font-size: 15px; }
  /* Contenedores de los marcadores (los botones se estilan en el <style global>) */
  .proc-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 34px;
  }

  /* Testimonios → carrusel de una cita (autoplay + swipe) */
  .tst-grid {
    display: flex;
    grid-template-columns: none;
    gap: 0;
    margin: 0 -10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .tst-grid::-webkit-scrollbar { display: none; }
  .tst-item, .tst-item:first-child {
    flex: 0 0 100%;
    box-sizing: border-box;
    scroll-snap-align: center;
    border-top: none;
    padding: 0 10px;
  }
  .tst-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 13px;
    margin-top: 38px;
  }
}

</style>

<!-- ── Estilos de los marcadores (botones creados por JS → fuera del scope de Astro) ── -->
<style is:global>
  /* Proceso → barras "palito" con relleno de progreso (premium) */
  .proc-dot {
    width: 20px;
    height: 3px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(247, 239, 219, 0.2);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s ease;
  }
  .proc-dot[aria-selected="true"] {
    width: 48px;
    background: rgba(247, 239, 219, 0.22);
  }
  /* Relleno que acompaña al autoplay (5s, sincronizado con el temporizador JS) */
  .proc-dot[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #F7EFDB;
    transform: scaleX(0);
    transform-origin: left center;
    animation: procFill 5s linear forwards;
  }
  @keyframes procFill { to { transform: scaleX(1); } }
  /* En pausa (tras tocar): la barra activa queda fija y llena, sin animación */
  .proc-dots.is-paused .proc-dot[aria-selected="true"] { background: #F7EFDB; }
  .proc-dots.is-paused .proc-dot[aria-selected="true"]::after { display: none; }

  /* Testimonios → puntos con halo (premium) */
  .tst-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: none;
    border-radius: 50%;
