<script is:inline>

  /* ════ ROUTING: URLs amigables por sección ════ */
  /* Mapa bidireccional entre id de página y ruta de URL */
  const PAGE_ROUTES = {
    home:    "/",
    works:   "/trabajos"
  };
  const ROUTE_TO_PAGE = Object.fromEntries(
    Object.entries(PAGE_ROUTES).map(([id, path]) => [path, id])
  );

  function showPage(id, opts) {
    opts = opts || {};
    document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
    const target = document.getElementById(id);
    if (!target) return;
    target.classList.add("active");
    window.scrollTo(0,0);

    /* Actualiza la URL sin recargar la página */
    if (!opts.skipHistory) {
      const path = PAGE_ROUTES[id] || "/";
      const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";
      if (currentPath !== path) {
        history.pushState({ page: id }, "", path);
      }
    }
  }

  const _originalOpenModal = (typeof openModal === "function") ? openModal : null;

  /* Al cargar, lee la URL y muestra la sección correspondiente */
  (function initRouteFromURL() {
    const path = window.location.pathname.replace(/\/+$/, "") || "/";
    if (path === "/contacto") {
      showPage("home", { skipHistory: true });
      if (_originalOpenModal) setTimeout(_originalOpenModal, 50);
      return;
    }
    const pageId = ROUTE_TO_PAGE[path];
    if (pageId && pageId !== "home") {
      showPage(pageId, { skipHistory: true });
    }
  })();

  /* Maneja los botones Atrás/Adelante del navegador */
  window.addEventListener("popstate", () => {
    const path = window.location.pathname.replace(/\/+$/, "") || "/";
    if (path === "/contacto") {
      showPage("home", { skipHistory: true });
      if (_originalOpenModal) _originalOpenModal();
      return;
    }
    const pageId = ROUTE_TO_PAGE[path] || "home";
    showPage(pageId, { skipHistory: true });
  });

  /* ════ WORKS FILTERS ════ */
  (function initWorksFilters() {
    const filtersEl = document.getElementById("worksFilters");
    if (!filtersEl) return;

    const cards = document.querySelectorAll("#worksGrid .work-card");
    const countEl = document.getElementById("worksCount");

    const FILTER_ROUTES = {
      "all":         "/trabajos",
      "branding":    "/trabajos/branding",
      "social":      "/trabajos/redes-sociales",
      "photography": "/trabajos/fotografia",
      "direction":   "/trabajos/direccion-creativa"
    };
    const ROUTE_TO_FILTER = Object.fromEntries(
      Object.entries(FILTER_ROUTES).map(([f, p]) => [p, f])
    );

    function applyFilter(filter, opts) {
      opts = opts || {};
      filtersEl.querySelectorAll(".filter-btn").forEach(b => {
        b.classList.toggle("active", b.dataset.filter === filter);
      });
      let visible = 0;
      cards.forEach(card => {
        const match = (filter === "all") || (card.dataset.category === filter);
        card.classList.toggle("hidden", !match);
        if (match) visible++;
      });
      if (countEl) countEl.textContent = visible;
      if (!opts.skipHistory) {
        const path = FILTER_ROUTES[filter] || "/trabajos";
        const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";
        if (currentPath !== path) history.pushState({ filter }, "", path);
      }
    }

    filtersEl.addEventListener("click", (e) => {
      const btn = e.target.closest(".filter-btn");
      if (!btn) return;
      applyFilter(btn.dataset.filter);
    });

    const initPath = window.location.pathname.replace(/\/+$/, "") || "/";
    const initFilter = ROUTE_TO_FILTER[initPath] || "all";
    applyFilter(initFilter, { skipHistory: true });

    /* Exponer para uso externo (flecha landing, nav) */
    window.applyFilter = applyFilter;
  })();

  let pillActive = false;
  function activatePill() {
    if (pillActive) return;
    pillActive = true;
    const btn = document.getElementById("pillBtn");
    btn.classList.add("expanded");
    setTimeout(() => document.getElementById("pillInput").focus(), 220);
    setTimeout(() => document.addEventListener("click", collapsePillOut), 150);
  }
  function collapsePillOut(e) {
    const btn = document.getElementById("pillBtn");
    const inp = document.getElementById("pillInput");
    if (!btn.contains(e.target)) {
      if (!inp.value.trim()) { pillActive = false; btn.classList.remove("expanded"); }
      document.removeEventListener("click", collapsePillOut);
    }
  }
  function handleArrow(e) {
    e.stopPropagation();
    if (!pillActive) { activatePill(); return; }
    openDrawer();
  }
  function onPillKey(e) { if (e.key === "Enter") { e.preventDefault(); openDrawer(); } }

  function openDrawer() {
    const q = document.getElementById("pillInput").value.trim();
    document.getElementById("drawerConsulta").value = q;
    ["drawerNombre","drawerEmail","drawerTelefono"].forEach(id => document.getElementById(id).value = "");
    document.getElementById("drawerWebsite").value = "";
    const dErr = document.getElementById("drawerError");
    if (dErr) dErr.style.display = "none";
    const dBtn = document.getElementById("drawerSendBtn");
    if (dBtn) {
      dBtn.disabled = false;
      dBtn.style.opacity = "";
      dBtn.style.cursor = "";
      dBtn.innerHTML = 'Enviar<svg class="send-plane" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>';
    }
    document.getElementById("drawerForm").style.display = "block";
    document.getElementById("drawerSuccess").classList.remove("show");
    document.getElementById("drawerOverlay").classList.add("open");
    document.body.style.overflow = "hidden";
    window.scrollTo(0,0);
  }
  function closeDrawer() {
    document.getElementById("drawerOverlay").classList.remove("open");
    document.body.style.overflow = "";
  }
  /* ════ EmailJS config ════ */
  const EMAILJS_SERVICE_ID    = "service_itdpucz";
  const EMAILJS_TEMPLATE_A    = "template_1onca15"; // consulta (con {{consulta}})
  const EMAILJS_TEMPLATE_B    = "template_a9a415g"; // contacto genérico

  /* Valida formato básico de email */
  function isValidEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  }

  /* Envía con EmailJS. Devuelve una promesa. */
  function sendEmail(templateId, params) {
    if (typeof emailjs === "undefined" || !emailjs.send) {
      return Promise.reject(new Error("SDK no cargado"));
    }
    return emailjs.send(EMAILJS_SERVICE_ID, templateId, params);
  }

  async function sendDrawer() {
    const btn      = document.getElementById("drawerSendBtn");
    const errorEl  = document.getElementById("drawerError");
    const nombre   = document.getElementById("drawerNombre").value.trim();
    const email    = document.getElementById("drawerEmail").value.trim();
    const telefono = document.getElementById("drawerTelefono").value.trim();
    const consulta = document.getElementById("drawerConsulta").value.trim();
    const honeypot = document.getElementById("drawerWebsite").value;

    if (honeypot) {
      document.getElementById("drawerForm").style.display = "none";
      document.getElementById("drawerSuccess").classList.add("show");
      setTimeout(closeDrawer, 3000);
      return;
    }

    errorEl.style.display = "none";
    if (!nombre || !email) {
      errorEl.textContent = "Por favor completa tu nombre y email.";
      errorEl.style.display = "block";
      return;
    }
    if (!isValidEmail(email)) {
      errorEl.textContent = "El email no parece válido. Revísalo.";
      errorEl.style.display = "block";
      return;
    }

    const btnTextOriginal = btn.innerHTML;
    btn.disabled = true;
    btn.style.opacity = "0.6";
    btn.style.cursor = "wait";
    btn.innerHTML = "Enviando...";

    try {
      const res = await fetch(`/api/send?nombre=${encodeURIComponent(nombre)}&email=${encodeURIComponent(email)}&telefono=${encodeURIComponent(telefono||'')}&consulta=${encodeURIComponent(consulta||'')}`, { method: 'POST' });
      if (!res.ok) throw new Error('Error');
      document.getElementById("drawerForm").style.display = "none";
      document.getElementById("drawerSuccess").classList.add("show");
      setTimeout(closeDrawer, 3000);
    } catch (err) {
      errorEl.textContent = "No hemos podido enviar el mensaje. Inténtalo de nuevo en unos segundos.";
      errorEl.style.display = "block";
      btn.disabled = false;
      btn.style.opacity = "";
      btn.style.cursor = "";
      btn.innerHTML = btnTextOriginal;
    }
  }

  function openModal() {
    ["mNombre","mEmail","mTelefono"].forEach(id => document.getElementById(id).value = "");
    document.getElementById("mWebsite").value = "";
    const mErr = document.getElementById("mError");
    if (mErr) mErr.style.display = "none";
    const mBtn = document.getElementById("mSendBtn");
    if (mBtn) {
      mBtn.disabled = false;
      mBtn.style.opacity = "";
      mBtn.style.cursor = "";
      mBtn.innerHTML = 'Enviar<svg class="send-plane" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>';
    }
    document.getElementById("modalForm").style.display = "block";
    document.getElementById("modalSuccess").classList.remove("show");
    document.getElementById("modalOverlay").classList.add("open");
    document.body.style.overflow = "hidden";
    window.scrollTo(0,0);
  }
  function closeModal() {
    document.getElementById("modalOverlay").classList.remove("open");
    document.body.style.overflow = "";
    /* Si la URL quedó en /contacto, la revertimos a la página visible */
    if (window.location.pathname.replace(/\/+$/, "") === "/contacto") {
      const activePage = document.querySelector(".page.active");
      const id = activePage ? activePage.id : "home";
      const path = PAGE_ROUTES[id] || "/";
      history.replaceState({ page: id }, "", path);
    }
  }
  async function sendModal() {
    const btn      = document.getElementById("mSendBtn");
    const errorEl  = document.getElementById("mError");
    const nombre   = document.getElementById("mNombre").value.trim();
    const email    = document.getElementById("mEmail").value.trim();
    const telefono = document.getElementById("mTelefono").value.trim();
    const honeypot = document.getElementById("mWebsite").value;

    if (honeypot) {
      document.getElementById("modalForm").style.display = "none";
      document.getElementById("modalSuccess").classList.add("show");
      setTimeout(closeModal, 3000);
      return;
    }

    errorEl.style.display = "none";
    if (!nombre || !email) {
      errorEl.textContent = "Por favor completa tu nombre y email.";
      errorEl.style.display = "block";
      return;
    }
    if (!isValidEmail(email)) {
      errorEl.textContent = "El email no parece válido. Revísalo.";
      errorEl.style.display = "block";
      return;
    }

    const btnTextOriginal = btn.innerHTML;
    btn.disabled = true;
    btn.style.opacity = "0.6";
    btn.style.cursor = "wait";
    btn.innerHTML = "Enviando...";

    /* El modal siempre usa la plantilla B (contacto genérico) */
    const params = {
      name:     nombre,
      email:    email,
      phone:    telefono || "No facilitado",
      consulta: "Sin consulta previa",
      reply_to: email
    };

    try {
      await sendEmail(EMAILJS_TEMPLATE_B, params);
      document.getElementById("modalForm").style.display = "none";
      document.getElementById("modalSuccess").classList.add("show");
      setTimeout(closeModal, 3000);
    } catch (err) {
      console.error("EmailJS error:", err);
      errorEl.textContent = "No hemos podido enviar el mensaje. Inténtalo de nuevo en unos segundos.";
      errorEl.style.display = "block";
      btn.disabled = false;
      btn.style.opacity = "";
      btn.style.cursor = "";
      btn.innerHTML = btnTextOriginal;
    }
  }

  document.addEventListener("keydown", e => {
    if (e.key === "Escape") { closeDrawer(); closeModal(); }
  });

  /* ════ PROTECCIÓN DESCARGA ════ */
  /* Bloquea clic derecho, arrastrar imágenes y el atributo download en vídeos */
  document.addEventListener("contextmenu", function(e) {
    if (e.target.closest("img, video, .work-media, .gallery-item, .hw3-item, .ds-item, .gallery-cv-item, .lightbox-overlay")) {
      e.preventDefault();
    }
  });
  document.addEventListener("dragstart", function(e) {
    if (e.target.tagName === "IMG" || e.target.tagName === "VIDEO") {
      e.preventDefault();
    }
  });
  /* Quitar controlMenuMouse en vídeos (iOS long-press save) */
  document.querySelectorAll("video").forEach(function(v) {
    v.setAttribute("controlslist", "nodownload");
    v.addEventListener("contextmenu", function(e){ e.preventDefault(); });
  });
</script>
