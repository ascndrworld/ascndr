    "description": "Transformación completa del pub Milenio 2.0 en Cónclave: naming, identidad visual, señalética y gestión de redes sociales en Jaén.",
    "creator": { "@type": "Organization", "name": "Ascndr", "url": "https://www.ascndrworld.com" },
    "keywords": ["rebranding", "dirección creativa", "pub", "hostelería", "Jaén"],
