<Layout title="Ascndr | Consultoría Creativa - Branding, Lanzamientos y RRSS">


<!-- ════ HOME ════ -->
<div id="home" class="page active">

  <!-- VÍDEO DE FONDO — muted al inicio para garantizar autoplay -->
  <video
    class="home-video-bg"
    id="homeVideoBg"
    muted
    autoplay
    loop
    playsinline
    webkit-playsinline="true"
    preload="auto"
    disablepictureinpicture
    aria-hidden="true"
    poster="/video/hero-poster.jpg"
    src="/video/hero.mp4"></video>
  <div class="home-video-overlay" aria-hidden="true"></div>
  <script is:inline>
    (function() {
      var v = document.getElementById('homeVideoBg');
      if (!v) return;
      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      function tryPlay() {
        try {
          var p = v.play();
          if (p && p.catch) p.catch(function() { /* reintentaremos en gesto */ });
        } catch (e) {}
      }
      if (v.readyState >= 2) tryPlay();
      v.addEventListener('loadedmetadata', tryPlay);
      v.addEventListener('loadeddata', tryPlay);
      v.addEventListener('canplay', tryPlay);
      // Reintenta al primer gesto si el navegador bloqueó autoplay
      function resume() {
        tryPlay();
        ['touchstart','click','scroll','keydown'].forEach(function(e){ window.removeEventListener(e, resume); });
      }
      ['touchstart','click','scroll','keydown'].forEach(function(e){
        window.addEventListener(e, resume, { passive: true });
      });
    })();
  </script>

  <!-- HERO: texto izquierda, pegado arriba tras el header -->
  <div class="home-hero-content">
    <h1 class="home-hero-title">eleva<br/>tu marca<br/>o te quedas<br/>donde estás.</h1>
