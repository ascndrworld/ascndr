---
import Layout from "../layouts/Layout.astro";

// Marcas que han confiado — logos reales, en su color original, integrados
// en el hero debajo del CTA, en movimiento (marquee). Se repite el set y luego
// se duplica el grupo entero para que el bucle no tenga saltos.
// scale = ajuste óptico por logo para que se vean a la misma altura real
// (cada PNG rellena su caja distinto: Halloween lleva subtítulo y letras altas).
const logos = [
  { name: "Halloween Fest", src: "/images/marcas/halloween-fest.png", scale: 1.34 },
  { name: "Cónclave", src: "/images/marcas/conclave.png", scale: 1.13 },
  { name: "Eventsy", src: "/images/marcas/eventsy.png", scale: 0.98 },
];
const group = Array.from({ length: 4 }, () => logos).flat();
---

<Layout
  title="Ascndr | Consultoría Creativa - Branding, Lanzamientos y RRSS"
  description="Branding, dirección creativa de eventos, fotografía y gestión de redes sociales. Desde Jaén, para marcas de toda España. Eleva tu marca con visión estratégica."
  canonical="https://www.ascndrworld.com"
  ogImage="https://www.ascndrworld.com/images/og-ascndr.jpg"
>


<!-- ════ HOME ════ -->
<div id="home" class="page active">

  <!-- VÍDEO DE FONDO — muted al inicio para garantizar autoplay -->
  <video
    class="home-video-bg"
    id="homeVideoBg"
    muted
    autoplay
    loop
    playsinline
    webkit-playsinline="true"
    preload="metadata"
    disablepictureinpicture
    aria-hidden="true"
    poster="/video/hero-poster.jpg"
    src="/video/hero.mp4"></video>
  <div class="home-video-overlay" aria-hidden="true"></div>
  <script is:inline>
    (function() {
      var v = document.getElementById('homeVideoBg');
      if (!v) return;
      v.muted = true;
      v.defaultMuted = true;
      v.playsInline = true;
      v.setAttribute('muted', '');
      v.setAttribute('playsinline', '');
      function tryPlay() {
        try {
          var p = v.play();
          if (p && p.catch) p.catch(function() { /* reintentaremos en gesto */ });
        } catch (e) {}
      }
      if (v.readyState >= 2) tryPlay();
      v.addEventListener('loadedmetadata', tryPlay);
      v.addEventListener('loadeddata', tryPlay);
      v.addEventListener('canplay', tryPlay);
      // Reintenta al primer gesto si el navegador bloqueó autoplay
      function resume() {
        tryPlay();
        ['touchstart','click','scroll','keydown'].forEach(function(e){ window.removeEventListener(e, resume); });
      }
      ['touchstart','click','scroll','keydown'].forEach(function(e){
        window.addEventListener(e, resume, { passive: true });
      });
    })();
  </script>

  <!-- HERO: texto izquierda, pegado arriba tras el header -->
  <div class="home-hero-content">
    <h1 class="home-hero-title">eleva<br/>tu marca<br/>o quédate<br/>donde estás.</h1>
    <a class="home-hero-btn" href="/proyectos">VER PROYECTOS</a>
  </div>

  </div><!-- /#home -->

  <!-- ════ MARCAS QUE HAN CONFIADO (strip en movimiento, bajo el header) ════ -->
  <section class="brandstrip" aria-label="Marcas que han confiado en Ascndr">
    <p class="brandstrip-eyebrow">Han confiado en nosotros</p>
    <!-- PC: 3 logos fijos y centrados (de momento; con más marcas → movimiento) -->
    <div class="brandstrip-static">
      {logos.map((b) => (
        <img class="brandstrip-logo" src={b.src} alt={b.name} loading="lazy" style={`--brand-scale:${b.scale}`} />
      ))}
    </div>
    <!-- Móvil: en movimiento (marquee) -->
    <div class="brandstrip-marquee" aria-hidden="true">
      <div class="brandstrip-track">
        {[...group, ...group].map((b) => (
          <img class="brandstrip-logo" src={b.src} alt="" aria-hidden="true" loading="eager" decoding="async" draggable="false" style={`--brand-scale:${b.scale}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- ════ SECCIÓN SERVICIOS — igual que "branding" en Somos ════ -->
  <section class="hs-services">
    <h2 class="hs-services-title">consultoría<br/>creativa</h2>
    <p class="hs-services-text">La identidad visual es la primera impresión que se lleva un cliente de tu marca. Trabajamos para que sea la correcta.</p>
    <p class="hs-services-text">Branding, dirección creativa, web, redes sociales. Todo bajo una misma visión estratégica.</p>
    <a class="hs-services-btn" href="/contacto">HABLEMOS DE TU MARCA</a>
  </section>

  <!-- ════ SECCIÓN SERVICIOS DESGLOSADOS ════ -->
