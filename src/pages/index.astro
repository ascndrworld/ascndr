    "description": "Diseño de identidad visual completa para Halloween Fest Jaén: logo, carteles, pulseras, acreditaciones y dirección creativa del evento.",
    "creator": { "@type": "Organization", "name": "Ascndr", "url": "https://www.ascndrworld.com" },
    "keywords": ["branding", "identidad visual", "evento", "Halloween", "Jaén"],
