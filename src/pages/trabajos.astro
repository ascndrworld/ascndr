<script is:inline>
var hwImgs=["/images/halloween-fest/tickets.jpg","/images/halloween-fest/cartel-oficial.jpg","/images/halloween-fest/cartel-3-0.jpg","/images/halloween-fest/acreditacion.jpg","/images/halloween-fest/pulseras.jpg"];
var lbIndex=0;
function openGallery(){document.getElementById("galleryHalloween").classList.add("open");document.body.style.overflow="hidden";window.scrollTo(0,0);}
function closeGallery(){document.getElementById("galleryHalloween").classList.remove("open");document.body.style.overflow="";}
function openLightbox(i){lbIndex=i;document.getElementById("lightboxImg").src=hwImgs[i];document.getElementById("lightboxCounter").textContent=(i+1)+" / "+hwImgs.length;document.getElementById("lightboxOverlay").classList.add("open");}
function closeLightbox(){document.getElementById("lightboxOverlay").classList.remove("open");}
function moveLightbox(dir){lbIndex=(lbIndex+dir+hwImgs.length)%hwImgs.length;document.getElementById("lightboxImg").src=hwImgs[lbIndex];document.getElementById("lightboxCounter").textContent=(lbIndex+1)+" / "+hwImgs.length;}
</script>

