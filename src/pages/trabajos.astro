<style>
.ds-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
}
@media (max-width: 640px) {
  .ds-grid { grid-template-columns: 1fr; }
}
.ds-item {
  cursor: pointer;
  overflow: hidden;
}
.ds-item img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform .35s ease;
}
.ds-item:hover img { transform: scale(1.02); }
</style>
