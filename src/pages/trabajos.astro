  background: linear-gradient(90deg, transparent, rgba(255,255,244,.05), transparent);
  animation: qmSweep 3.5s ease-in-out infinite;
}
@keyframes qmSweep { 0%{left:-80%} 60%{left:140%} 100%{left:140%} }
