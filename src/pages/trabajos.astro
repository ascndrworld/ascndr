---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Trabajos | Ascndr — Portfolio Creativo"
  description="Portfolio de proyectos de Ascndr: branding, dirección creativa, fotografía de eventos y gestión de redes sociales en Jaén y Andalucía."
  canonical="https://www.ascndrworld.com/trabajos"
>

<!-- ENCABEZADO SEO (oculto visualmente, accesible para Googlebot y lectores) -->
<h1 class="tp-sr-only">Portfolio de Ascndr — Branding, Dirección Creativa, Fotografía y Redes Sociales</h1>

<!-- FILTROS — desplegable centrado, estilo Somos -->
<div class="tp-filter-section">
  <div class="tp-filter-dropdown" id="tpDropdown">
    <button class="tp-filter-trigger" id="tpTrigger" type="button" aria-haspopup="listbox" aria-expanded="false">
      <span class="tp-filter-current" id="tpCurrent">Filter</span>
      <svg class="tp-filter-caret" viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <ul class="tp-filter-menu" id="tpMenu" role="listbox">
      <li><button class="tp-filter-option active" type="button" role="option" aria-selected="true" data-filter="all">All</button></li>
      <li><button class="tp-filter-option" type="button" role="option" data-filter="branding">Branding</button></li>
      <li><button class="tp-filter-option" type="button" role="option" data-filter="social">Redes Sociales</button></li>
      <li><button class="tp-filter-option" type="button" role="option" data-filter="photography">Fotografía</button></li>
      <li><button class="tp-filter-option" type="button" role="option" data-filter="direction">Dirección Creativa</button></li>
      <li><button class="tp-filter-option" type="button" role="option" data-filter="web">Web</button></li>
    </ul>
  </div>
</div>

<!-- GRID — 4 columnas cuadradas, gap:0, igual Somos -->
<div class="tp-grid" id="tpGrid">

  <a class="tp-item" data-category="direction" href="/trabajos/direccion-creativa/conclave">
    <div class="tp-img" style="background-image:url('/images/conclave/portada-conclave2.jpg'); background-position:center 44%;"></div>
    <div class="tp-hover">
      <span class="tp-hover-cat">Dirección Creativa</span>
      <span class="tp-hover-title">Cónclave</span>
    </div>
  </a>

  <a class="tp-item" data-category="branding" href="/trabajos/branding/halloweenfest">
    <div class="tp-img" style="background-image:url('/images/halloween-fest/pulsera-portada.jpg')"></div>
    <div class="tp-hover">
      <span class="tp-hover-cat">Branding</span>
      <span class="tp-hover-title">Halloween Fest</span>
    </div>
  </a>

