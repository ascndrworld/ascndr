      <div class="qm-success-icon"><i class="ti ti-check" aria-hidden="true"></i></div>
      <div class="qm-title">Recibido</div>
      <div class="qm-sub" style="margin-bottom:20px;">
        Revisaremos tu web y redes antes de escribirte.<br/>
        Te mandamos un borrador de mejoras en menos de 24h.
      </div>
      <div style="background:#0f0f0f;border:0.5px solid #222;border-radius:8px;padding:14px 16px;text-align:left;margin-bottom:16px;">
        <div class="qm-field-label" style="margin-bottom:10px;">Recibirás</div>
        <div class="qm-checklist">
          <div class="qm-check-row"><i class="ti ti-circle-check" aria-hidden="true"></i><span>Revisión rápida de tu web y redes sociales</span></div>
          <div class="qm-check-row"><i class="ti ti-circle-check" aria-hidden="true"></i><span>3-5 puntos concretos de mejora</span></div>
          <div class="qm-check-row"><i class="ti ti-circle-check" aria-hidden="true"></i><span>Propuesta de lo que podríamos trabajar juntos</span></div>
        </div>
      </div>
      <p class="qm-note">Sin compromiso.</p>
    </div>

  </div>
</div>

<script is:inline>
var qmSelected = null;

function openQModal() {
  document.getElementById('qModalBackdrop').classList.add('open');
  document.body.style.overflow = 'hidden';
  qmReset(false);
}
function closeQModal() {
  document.getElementById('qModalBackdrop').classList.remove('open');
  document.body.style.overflow = '';
}
function qModalBackdropClick(e) {
  if (e.target === document.getElementById('qModalBackdrop')) closeQModal();
}

function qmGo(n) {
  [1,2,3].forEach(function(i) {
    document.getElementById('qmstep'+i).classList.toggle('active', i===n);
    var dot = document.getElementById('qmdot'+i);
    if (dot) dot.classList.toggle('done', i < n);
  });
  // dot for current step
  var cur = document.getElementById('qmdot'+n);
  if (cur && n <= 3) cur.classList.add('done');
}

function qmSelect(el, val) {
  document.querySelectorAll('.qm-opt').forEach(function(o){ o.classList.remove('selected'); });
  el.classList.add('selected');
  qmSelected = val;
  var extra = document.getElementById('qmNoseloExtra');
  if (val === 'noselo') {
    extra.classList.add('visible');
    qmCheckStep1();
  } else {
    extra.classList.remove('visible');
    document.getElementById('qmbtn1').disabled = false;
  }
}

function qmCheckStep1() {
  if (qmSelected === 'noselo') {
    document.getElementById('qmbtn1').disabled =
      document.getElementById('qmNoseloText').value.trim().length < 5;
  }
}

function qmCheckStep2() {
  var url = document.getElementById('qmUrl').value.trim();
  var email = document.getElementById('qmEmail').value.trim();
  document.getElementById('qmbtn2').disabled = !(url.length > 2 && email.includes('@'));
}

async function qmSend() {
  var tipo   = qmSelected || '';
  var noselo = document.getElementById('qmNoseloText').value.trim();
  var nombre = document.getElementById('qmNombre').value.trim();
  var url    = document.getElementById('qmUrl').value.trim();
  var email  = document.getElementById('qmEmail').value.trim();
  var consulta = tipo === 'noselo' ? ('No sé / orientación: ' + noselo) : tipo;

  try {
    await fetch(`/api/send?tipo=${encodeURIComponent(consulta)}&web=${encodeURIComponent(url)}&email=${encodeURIComponent(email)}&nombre=${encodeURIComponent(nombre)}`, { method: 'POST' });
  } catch(e) {}

  qmGo(3);
}

function qmReset(reopen) {
  qmSelected = null;
  document.querySelectorAll('.qm-opt').forEach(function(o){ o.classList.remove('selected'); });
  document.getElementById('qmNoseloExtra').classList.remove('visible');
  document.getElementById('qmNoseloText').value = '';
  document.getElementById('qmbtn1').disabled = true;
  document.getElementById('qmNombre').value = '';
  document.getElementById('qmUrl').value = '';
  document.getElementById('qmEmail').value = '';
  document.getElementById('qmbtn2').disabled = true;
  [1,2,3].forEach(function(i){
    var d = document.getElementById('qmdot'+i);
    if (d) d.classList.remove('done');
  });
  qmGo(1);
}
</script>


