<script is:inline>
  (function() {
    var grid = document.getElementById('tpGrid');
    var dropdown = document.getElementById('tpDropdown');
    var trigger = document.getElementById('tpTrigger');
    var menu = document.getElementById('tpMenu');
    var current = document.getElementById('tpCurrent');
    var options = document.querySelectorAll('.tp-filter-option');
    var items = document.querySelectorAll('.tp-item');

    function setOpen(open) {
      if (!dropdown) return;
      dropdown.classList.toggle('open', open);
      if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    if (trigger) {
      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        setOpen(!dropdown.classList.contains('open'));
      });
    }

    document.addEventListener('click', function(e) {
      if (!dropdown) return;
      if (!dropdown.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') setOpen(false);
    });

    options.forEach(function(opt) {
      opt.addEventListener('click', function() {
        options.forEach(function(o) {
          o.classList.remove('active');
          o.setAttribute('aria-selected', 'false');
        });
        opt.classList.add('active');
        opt.setAttribute('aria-selected', 'true');

        var f = opt.dataset.filter;
        if (grid) grid.classList.toggle('filtered', f !== 'all');
        items.forEach(function(item) {
          item.style.display = (f === 'all' || item.dataset.category === f) ? 'block' : 'none';
        });
        setOpen(false);
      });
    });

    // Logo Eventsy: entry stack + shuffle loop activos solo cuando la tira está en viewport
    var logo = document.querySelector('.eventsy-logo');
    if (logo && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          logo.classList.toggle('is-visible', e.isIntersecting);
        });
      }, { threshold: 0.25 });
      io.observe(logo);
    } else if (logo) {
      logo.classList.add('is-visible');
    }
  })();

</script>

<style>
  body { background: var(--bg, #000000) !important; }

  .tp-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .tp-filter-section {
    padding-top: 140px;
    padding-bottom: 24px;
    text-align: center;
    background: var(--bg, #000000);
  }

  /* DROPDOWN — centrado, estilo Somos */
  .tp-filter-dropdown {
    position: relative;
    display: inline-block;
    text-align: left;
  }
  .tp-filter-trigger {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: none;
    border: none;
    padding: 10px 4px;
    cursor: pointer;
    font-family: "Montserrat", sans-serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #F7EFDB;
    transition: color 0.2s;
  }
  .tp-filter-trigger:hover { color: #fff; }
  .tp-filter-caret {
    color: #F7EFDB;
    transition: transform 0.2s ease;
  }
  .tp-filter-dropdown.open .tp-filter-caret { transform: rotate(180deg); }

  .tp-filter-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    margin: 0;
    padding: 8px 0;
    list-style: none;
    min-width: 240px;
    background: #0a0a0a;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 12px 40px rgba(0,0,0,0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    z-index: 20;
  }
  .tp-filter-dropdown.open .tp-filter-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .tp-filter-menu li { margin: 0; padding: 0; }
  .tp-filter-option {
    width: 100%;
    background: none;
    border: none;
    padding: 10px 24px;
    text-align: center;
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: rgba(255,255,255,0.55);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .tp-filter-option:hover { color: #F7EFDB; background: rgba(255,255,255,0.04); }
  .tp-filter-option.active { color: #F7EFDB; font-weight: 600; }

  /* GRID — mosaico asimétrico 3 cols × 5 rows, estilo Somos
     Layout (5 trabajos):
       A A B
       A A B
       E E E   ← strip full width, media altura
       C D D
       C D D
     A,D: 2×2 grande · B,C: 1×2 alto · E: 3×1 (full-width, ½ altura)
     row-height = (100vh - filter_section ≈ 220px) / 2 → A+B ocupan justo el viewport */
  .tp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* filas 1-2: top (Cónclave/Halloween) · fila 3: tira Eventsy (40% más alta que media) · filas 4-5: bottom */
    grid-template-rows:
      calc((100vh - 220px) / 2)
      calc((100vh - 220px) / 2)
      calc((100vh - 220px) * 0.7)
      calc((100vh - 220px) / 2)
      calc((100vh - 220px) / 2);
    grid-auto-rows: calc((100vh - 220px) / 2);
    gap: 0;
    /* Mata cualquier hueco fantasma por nodos de texto entre <a> items */
    font-size: 0;
    line-height: 0;
    background: var(--bg, #000000);
  }

  .tp-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    display: block;
    vertical-align: top;
    text-decoration: none;
    color: inherit;
    /* Restablece la tipografía dentro del item (el grid usa font-size:0/line-height:0) */
    font-size: 16px;
    line-height: 1.4;
  }
  .tp-item:nth-child(1) { grid-column: span 2; grid-row: span 2; }
  .tp-item:nth-child(2) { grid-column: span 1; grid-row: span 2; }
  .tp-item:nth-child(3) { grid-column: span 3; grid-row: span 1; }
  .tp-item:nth-child(4) { grid-column: span 1; grid-row: span 2; }
  .tp-item:nth-child(5) { grid-column: span 2; grid-row: span 2; }


  /* Cuando hay un filtro activo, vuelve a rejilla uniforme 4 cols cuadrada
     para evitar huecos al ocultar items */
  .tp-grid.filtered {
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: auto;
  }
  .tp-grid.filtered .tp-item {
    grid-column: auto;
    grid-row: auto;
    aspect-ratio: 1 / 1;
  }

  .tp-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .tp-item:hover .tp-img { transform: scale(1.05); }

  /* Tira Eventsy — logo SVG inline al 38% del ancho, centrado sobre el fondo de la página */
  .tp-img--logo {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
  }
  .eventsy-logo {
    width: 38%;
    height: auto;
    display: block;
    overflow: visible; /* para que el shuffle no recorte */
  }

  /* Animación — estado inicial (oculto hasta entrar en viewport) */
  .eventsy-logo .eventsy-ticket,
  .eventsy-logo .eventsy-wordmark {
    transform-box: fill-box;
    transform-origin: center;
    will-change: transform, opacity;
  }
  .eventsy-logo .eventsy-ticket { opacity: 0; transform: translateY(-26px); }
  .eventsy-logo .eventsy-wordmark { opacity: 0; transform: translateX(-32px); }

  /* Entry stack: los 3 tickets caen en cascada (top → mid → bot), luego el wordmark
     hace un fade lateral. Tras la entry, los tickets entran en loop de baraja. */
  .eventsy-logo.is-visible .eventsy-ticket--top {
    animation:
      ev-drop 0.6s 0.10s cubic-bezier(0.22, 0.7, 0.28, 1) both,
      ev-shuffle-top 5.2s 1.55s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .eventsy-logo.is-visible .eventsy-ticket--mid {
    animation:
      ev-drop 0.6s 0.22s cubic-bezier(0.22, 0.7, 0.28, 1) both,
      ev-shuffle-mid 5.2s 1.55s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .eventsy-logo.is-visible .eventsy-ticket--bot {
    animation:
      ev-drop 0.6s 0.34s cubic-bezier(0.22, 0.7, 0.28, 1) both,
      ev-shuffle-bot 5.2s 1.55s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  .eventsy-logo.is-visible .eventsy-wordmark {
    animation: ev-slide-in 0.55s 0.55s cubic-bezier(0.22, 0.7, 0.28, 1) both;
  }

  @keyframes ev-drop {
    from { opacity: 0; transform: translateY(-26px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes ev-slide-in {
    from { opacity: 0; transform: translateX(-32px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* Baraja — los 3 tickets se abren en abanico y vuelven a apilarse.
     Pico de abertura ~22% y ~72% del ciclo; el resto stack neutro. */
  @keyframes ev-shuffle-top {
    0%, 45%, 100% { transform: translate(0, 0) rotate(0deg); }
    22%           { transform: translate(-8px, -3px) rotate(-7deg); }
    72%           { transform: translate(5px, -1px) rotate(-3deg); }
    90%           { transform: translate(0, 0) rotate(0deg); }
  }
  @keyframes ev-shuffle-mid {
    0%, 45%, 100% { transform: translate(0, 0) rotate(0deg); }
    22%           { transform: translate(2px, 0) rotate(1.5deg); }
    72%           { transform: translate(-2px, 0) rotate(-1.5deg); }
    90%           { transform: translate(0, 0) rotate(0deg); }
  }
  @keyframes ev-shuffle-bot {
    0%, 45%, 100% { transform: translate(0, 0) rotate(0deg); }
    22%           { transform: translate(8px, 3px) rotate(7deg); }
    72%           { transform: translate(-5px, 1px) rotate(3deg); }
    90%           { transform: translate(0, 0) rotate(0deg); }
  }

  /* Pausa el loop cuando la tira sale del viewport (perf + batería) */
  .eventsy-logo:not(.is-visible) .eventsy-ticket {
    animation: none;
  }

  /* Accesibilidad — respeta la preferencia de reducción de movimiento */
  @media (prefers-reduced-motion: reduce) {
    .eventsy-logo .eventsy-ticket,
    .eventsy-logo .eventsy-wordmark { opacity: 1; transform: none; }
    .eventsy-logo.is-visible .eventsy-ticket--top,
    .eventsy-logo.is-visible .eventsy-ticket--mid,
    .eventsy-logo.is-visible .eventsy-ticket--bot,
    .eventsy-logo.is-visible .eventsy-wordmark { animation: none; }
  }

  /* HOVER — rgba(0,0,0,0.7), texto abajo izquierda */
  .tp-hover {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.7);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
  }
  .tp-item:hover .tp-hover { opacity: 1; }

  .tp-hover-title {
    font-family: "Montserrat", sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #F7EFDB;
    display: block;
    line-height: 1.2;
  }
  .tp-hover-cat {
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: rgb(170,170,170);
    display: block;
    margin-bottom: 6px;
  }

  /* CTA */
  .tp-cta {
    background: var(--bg, #000000);
    padding: 60px 40px;
    text-align: center;
    font-family: "Montserrat", sans-serif;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .tp-cta p {
    font-size: 16px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 20px;
  }
  .tp-cta a {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #F7EFDB;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.5);
    padding: 12px 28px;
    transition: background 0.2s, color 0.2s;
  }
  .tp-cta a:hover { background: #fff; color: #000; }

  /* Tablet/Móvil — grid 2×2 de cuadrados proporcionados
       A B
       C D
     Los 2 primeros (A,B) se ven enteros sin scroll */
  @media (max-width: 768px) {
    .tp-filter-section { padding-top: 110px; padding-bottom: 16px; }
    .tp-filter-trigger { font-size: 18px; }
    .tp-filter-menu { min-width: 220px; }
    .tp-filter-option { font-size: 14px; padding: 9px 20px; }
    .tp-grid {
      grid-template-columns: repeat(2, 1fr);
      /* Anula las 5 filas explícitas de desktop — en móvil solo hay 3 filas (top/strip/bottom) */
      grid-template-rows: none;
      grid-auto-rows: auto;
      gap: 0;
      row-gap: 0;
      column-gap: 0;
    }
    .tp-item,
    .tp-item:nth-child(1),
    .tp-item:nth-child(2),
    .tp-item:nth-child(3),
    .tp-item:nth-child(4),
    .tp-item:nth-child(5) {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 1 / 1;
      margin: 0;
    }
    /* Strip Eventsy en móvil: banner rectangular fino */
    .tp-item:nth-child(3),
    .tp-item.tp-item--strip {
      grid-column: span 2;
      aspect-ratio: 6 / 1;
    }
    .tp-grid.filtered {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: auto;
      gap: 0;
    }
    .tp-grid.filtered .tp-item.tp-item--strip {
      grid-column: auto;
      aspect-ratio: 1 / 1;
    }
    /* Overlay siempre visible en móvil (sin :hover) con gradiente abajo */
    .tp-hover {
      opacity: 1;
      background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,0.7) 100%);
      padding: 12px;
    }
    .tp-hover-title { font-size: 15px; }
    .tp-hover-cat { font-size: 11px; }
    .tp-cta { padding: 22px 24px 32px; }
    .tp-cta p { font-size: 14px; margin-bottom: 14px; }
  }

  /* Móvil pequeño */
  @media (max-width: 480px) {
    .tp-filter-section { padding-top: 96px; padding-bottom: 12px; }
    .tp-filter-trigger { font-size: 16px; }
    .tp-hover { padding: 10px; }
    .tp-hover-title { font-size: 13px; line-height: 1.2; }
    .tp-hover-cat { font-size: 10px; margin-bottom: 3px; }
  }
</style>

