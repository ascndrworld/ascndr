  {type:"img",src:"/images/conclave/despues-03.jpg"},
  {type:"img",src:"/images/conclave/despues-04.jpg"},
  {type:"video",src:"/images/conclave/evento.mp4",poster:"/images/conclave/evento-poster.jpg"}
];
var cvIndex=0;
function openGalleryConclave(){document.getElementById("galleryConclave").classList.add("open");document.body.style.overflow="hidden";window.scrollTo(0,0);}
function closeGalleryConclave(){document.getElementById("galleryConclave").classList.remove("open");document.body.style.overflow="";closeLightboxConclave();}
function renderLightboxConclave(){var it=cvItems[cvIndex];var im=document.getElementById("lightboxConclaveImg");var vd=document.getElementById("lightboxConclaveVideo");if(it.type==="img"){vd.pause();vd.removeAttribute("src");vd.style.display="none";im.src=it.src;im.style.display="block";}else{im.style.display="none";im.removeAttribute("src");vd.src=it.src;if(it.poster)vd.poster=it.poster;vd.style.display="block";vd.play().catch(function(){});}document.getElementById("lightboxConclaveCounter").textContent=(cvIndex+1)+" / "+cvItems.length;}
function openLightboxConclave(i){cvIndex=i;renderLightboxConclave();document.getElementById("lightboxConclaveOverlay").classList.add("open");}
function moveLightboxConclave(dir){cvIndex=(cvIndex+dir+cvItems.length)%cvItems.length;renderLightboxConclave();}
function closeLightboxConclave(){var vd=document.getElementById("lightboxConclaveVideo");vd.pause();vd.removeAttribute("src");document.getElementById("lightboxConclaveOverlay").classList.remove("open");}
</script>

