<script is:inline>
  // Filtros portfolio
  (function initFilters() {
    var filtersEl = document.getElementById('worksFilters');
    if (!filtersEl) return;
    var cards = document.querySelectorAll('#worksGrid .work-card');
    var countEl = document.getElementById('worksCount');
    filtersEl.addEventListener('click', function(e) {
      var btn = e.target.closest('.filter-btn');
      if (!btn) return;
      filtersEl.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var filter = btn.dataset.filter;
      var visible = 0;
      cards.forEach(function(card) {
        var match = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      if (countEl) countEl.textContent = visible;
    });
    if (countEl) countEl.textContent = cards.length;
  })();
</script>
