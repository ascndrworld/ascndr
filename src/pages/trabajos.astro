---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Trabajos | Ascndr — Portfolio Creativo">

<!-- HEADER — idéntico al de Somos en /proyectos -->
<header class="tp-header">
  <a href="/" class="tp-logo">
    <img src="/ascndr-logo.png" alt="Ascndr"/>
  </a>
  <a href="/" class="tp-back">← Volver</a>
</header>

<!-- FILTROS — centrados, estilo Somos -->
<div class="tp-filter-section">
  <p class="tp-filter-label">Portfolio · 2024 — 2026</p>
  <div class="tp-filters" id="tpFilters">
    <button class="tp-filter active" data-filter="all">Todo</button>
    <button class="tp-filter" data-filter="branding">Branding</button>
    <button class="tp-filter" data-filter="social">Redes Sociales</button>
    <button class="tp-filter" data-filter="photography">Fotografía</button>
    <button class="tp-filter" data-filter="direction">Dirección Creativa</button>
  </div>
</div>

<!-- GRID — 4 columnas cuadradas, gap:0, igual Somos -->
<div class="tp-grid" id="tpGrid">

  <div class="tp-item" data-category="direction" onclick="openGalleryConclave()">
    <div class="tp-img" style="background-image:url('/images/conclave/portada-conclave2.jpg')"></div>
    <div class="tp-hover">
      <span class="tp-hover-cat">Dirección Creativa</span>
      <span class="tp-hover-title">Cónclave</span>
    </div>
  </div>

  <div class="tp-item" data-category="branding" onclick="openGallery()">
    <div class="tp-img" style="background-image:url('/images/halloween-fest/pulsera-portada.jpg')"></div>
    <div class="tp-hover">
      <span class="tp-hover-cat">Branding</span>
      <span class="tp-hover-title">Halloween Fest</span>
    </div>
  </div>

  <div class="tp-item" data-category="social" onclick="openGalleryConclaveDesign()">
    <div class="tp-img" style="background-image:url('/images/conclave/rrss-01.jpg')"></div>
    <div class="tp-hover">
      <span class="tp-hover-cat">Redes Sociales</span>
      <span class="tp-hover-title">Cónclave Design</span>
    </div>
  </div>

  <div class="tp-item" data-category="photography" onclick="openGalleryHalloween3()">
    <div class="tp-img" style="background-image:url('/images/halloween-fest/portada-halloween3.jpg')"></div>
    <div class="tp-hover">
      <span class="tp-hover-cat">Fotografía</span>
      <span class="tp-hover-title">Halloween Fest III</span>
    </div>
  </div>

</div>

<!-- CTA -->
<div class="tp-cta">
  <p>¿Tienes un proyecto en mente?</p>
  <a href="/contacto">Iniciar proyecto ›</a>
</div>

<script is:inline>
  (function() {
    var filters = document.querySelectorAll('.tp-filter');
    var items = document.querySelectorAll('.tp-item');
    filters.forEach(function(btn) {
      btn.addEventListener('click', function() {
        filters.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var f = btn.dataset.filter;
        items.forEach(function(item) {
          item.style.display = (f === 'all' || item.dataset.category === f) ? 'block' : 'none';
        });
      });
    });
  })();

  function openGallery() { window.location.href = '/'; }
  function openGalleryConclave() { window.location.href = '/'; }
  function openGalleryConclaveDesign() { window.location.href = '/'; }
  function openGalleryHalloween3() { window.location.href = '/'; }
</script>

<style>
  body { background: #0a0a0a !important; }

  .tp-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 162px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    background: rgba(0,0,0,0.9);
  }
  .tp-logo img {
    height: 60px;
    width: auto;
    filter: brightness(0) invert(1);
  }
  .tp-back {
    position: absolute;
    left: 40px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    text-decoration: none;
    font-family: "Montserrat", sans-serif;
    transition: color 0.2s;
  }
  .tp-back:hover { color: #fff; }

  .tp-filter-section {
    padding-top: 182px;
    padding-bottom: 24px;
    text-align: center;
    background: #0a0a0a;
  }
  .tp-filter-label {
    font-family: "Montserrat", sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
    margin-bottom: 16px;
  }
  .tp-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }
  .tp-filter {
    font-family: "Montserrat", sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: rgba(255,255,255,0.45);
    background: none;
    border: none;
    padding: 8px 17px;
    cursor: pointer;
    transition: color 0.2s;
  }
  .tp-filter:hover { color: #fff; }
  .tp-filter.active { color: #fff; font-weight: 600; }

  /* GRID — 4 cols, cuadrado, gap:0, igual Somos */
  .tp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    background: #0a0a0a;
  }

  .tp-item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    cursor: pointer;
  }

  .tp-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .tp-item:hover .tp-img { transform: scale(1.05); }

  /* HOVER — rgba(0,0,0,0.7), texto abajo izquierda */
  .tp-hover {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.7);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
  }
  .tp-item:hover .tp-hover { opacity: 1; }

  .tp-hover-title {
    font-family: "Montserrat", sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #fff;
    display: block;
    line-height: 1.2;
  }
  .tp-hover-cat {
    font-family: "Montserrat", sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: rgb(170,170,170);
    display: block;
    margin-bottom: 6px;
  }

  /* CTA */
  .tp-cta {
    background: #0a0a0a;
    padding: 60px 40px;
    text-align: center;
    font-family: "Montserrat", sans-serif;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .tp-cta p {
    font-size: 16px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 20px;
  }
  .tp-cta a {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.5);
    padding: 12px 28px;
    transition: background 0.2s, color 0.2s;
  }
  .tp-cta a:hover { background: #fff; color: #000; }

  @media (max-width: 900px) {
    .tp-grid { grid-template-columns: repeat(2, 1fr); }
    .tp-filter { font-size: 16px; padding: 6px 12px; }
    .tp-header { height: 100px; }
    .tp-filter-section { padding-top: 120px; }
    .tp-logo img { height: 44px; }
    .tp-back { left: 20px; }
  }
  @media (max-width: 480px) {
    .tp-filter { font-size: 13px; padding: 5px 8px; }
  }
</style>

</Layout>
